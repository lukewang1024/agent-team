#!/usr/bin/env python3
"""Native team launch adapters and an opt-in interactive tmux team controller."""
import argparse
import contextlib
import hashlib
import http.client
from html.parser import HTMLParser
import json
import math
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

ROOT = Path(__file__).resolve().parents[1]
CONFIG = ROOT / "config"
TOOLS = ("codex", "traex", "opencode", "claude")
TEAM_BORDER_FORMAT = " #{?@agent_team_role,#{@agent_team_role} | ,}#{pane_title} "
CODEX_RADAR_MENU_CACHE = None
CODEX_RADAR_RUNTIME = False


def fail(message):
    raise RuntimeError(message)


def read(path):
    return json.loads(Path(path).read_text())


def write(path, value):
    path = Path(path)
    temp = path.with_name(path.name + "." + str(os.getpid()) + "." + uuid.uuid4().hex + ".tmp")
    temp.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n")
    temp.chmod(0o600)
    temp.replace(path)


def merge(base, extra):
    for key, value in extra.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            merge(base[key], value)
        else:
            base[key] = value
    return base


def codex_radar_options():
    options = read(CONFIG / "codexradar.json")
    if not isinstance(options, dict):
        fail("Codex Radar settings must be an object")
    user_config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-team/config.json"
    if user_config.exists():
        user_settings = read(user_config)
        if not isinstance(user_settings, dict):
            fail("User configuration must be an object in " + str(user_config))
        personal = user_settings.get("codex_radar", {})
        if not isinstance(personal, dict):
            fail("codex_radar settings must be an object in " + str(user_config))
        merge(options, personal)
    url = options.get("url")
    if not isinstance(url, str) or not url.startswith("https://"):
        fail("Codex Radar URL must use HTTPS")
    interval = options.get("refresh_interval_seconds", 86400)
    if type(interval) not in (int, float) or interval < 60:
        fail("Codex Radar refresh_interval_seconds must be at least 60")
    failure_interval = options.get("failure_retry_interval_seconds", 300)
    if type(failure_interval) not in (int, float) or failure_interval < 60:
        fail("Codex Radar failure_retry_interval_seconds must be at least 60")
    menu_category_limit = options.get("menu_category_limit")
    if menu_category_limit is not None and (type(menu_category_limit) is not int or menu_category_limit < 1):
        fail("Codex Radar menu_category_limit must be a positive integer")
    return options


def codex_radar_cache_path():
    cache_home = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache")))
    return cache_home / "agent-team" / "codexradar-recommendations.json"


def codex_radar_pending_cache_path():
    return codex_radar_cache_path().with_name("codexradar-recommendations.pending.json")


def codex_radar_url_label(url):
    parsed = urllib.parse.urlsplit(url)
    host = parsed.hostname or "unknown-host"
    if parsed.port:
        host += ":" + str(parsed.port)
    return urllib.parse.urlunsplit((parsed.scheme, host, parsed.path, "", ""))


def normalize_codex_radar(recommendations):
    items = []
    for recommendation in recommendations:
        source_key = recommendation["key"]
        label = "".join(character for character in recommendation["title"]
                        if character.isprintable() and character != "#").strip()[:80]
        for item in recommendation["items"]:
            raw_model = item["model"]
            raw_effort = item["effort"]
            if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._ -]{0,63}", raw_model):
                continue
            if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_ -]{0,23}", raw_effort):
                continue
            model_id = re.sub(r"\s+", "-", raw_model.lower())
            effort_id = re.sub(r"[\s_-]+", "", raw_effort.lower())
            stable_suffix = hashlib.sha256((source_key + "\0" + model_id + "\0" + effort_id).encode("utf-8")).hexdigest()[:10]
            items.append({
                "id": source_key + "-" + stable_suffix,
                "source_key": source_key,
                "label": label + " · " + raw_model + " " + raw_effort + (" + Fast" if item["fast"] else ""),
                "model": model_id,
                "effort": effort_id,
                "fast": item["fast"],
            })
    return {"items": items}


class CodexRadarHTMLParser(HTMLParser):
    BLOCK_TAGS = {
        "article", "aside", "blockquote", "br", "dd", "div", "dl", "dt",
        "figcaption", "figure", "footer", "form", "header", "li", "main",
        "nav", "ol", "p", "section", "table", "td", "th", "tr", "ul",
    }
    INLINE_TAGS = {"b", "code", "em", "i", "span", "strong"}
    SKIP_TAGS = {"script", "style", "noscript", "template"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.events = []
        self.text = []
        self.heading = None
        self.skipping = None

    def flush_text(self):
        value = "".join(self.text)
        if value.strip():
            self.events.append(("text", value))
        self.text = []

    def handle_starttag(self, tag, attrs):
        if self.skipping:
            return
        if tag in self.SKIP_TAGS:
            self.flush_text()
            self.skipping = tag
            return
        if len(tag) == 2 and tag[0] == "h" and tag[1] in "123456":
            self.flush_text()
            self.heading = (int(tag[1]), [])
            return
        if tag in self.BLOCK_TAGS:
            target = self.heading[1] if self.heading else self.text
            target.append("\n")
        elif tag in self.INLINE_TAGS:
            target = self.heading[1] if self.heading else self.text
            target.append(" ")

    def handle_endtag(self, tag):
        if self.skipping:
            if tag == self.skipping:
                self.skipping = None
            return
        if self.heading and len(tag) == 2 and tag[0] == "h" and tag[1] in "123456":
            level, parts = self.heading
            label = re.sub(r"\s+", " ", "".join(parts)).strip()
            self.events.append(("heading", level, label))
            self.heading = None
        elif tag in self.BLOCK_TAGS:
            self.text.append("\n")
        elif tag in self.INLINE_TAGS:
            self.text.append(" ")

    def handle_data(self, data):
        if self.skipping:
            return
        target = self.heading[1] if self.heading else self.text
        target.append(data)


def normalize_codex_radar_html(document, options):
    parser = CodexRadarHTMLParser()
    parser.feed(document)
    parser.close()
    parser.flush_text()

    section_level = None
    scene_level = None
    scenes = []
    current_scene = None
    in_section = False
    for event in parser.events:
        if event[0] == "heading":
            _, level, label = event
            compact_label = re.sub(r"[^a-z0-9\u3400-\u9fff]+", "", label.lower())
            if not in_section and ("站长推荐" in compact_label or "stationpicks" in compact_label
                                   or "stationrecommendations" in compact_label):
                in_section = True
                section_level = level
                continue
            if not in_section:
                continue
            if level <= section_level:
                break
            if scene_level is None:
                scene_level = level
            if level == scene_level:
                current_scene = {"title": label, "text": []}
                scenes.append(current_scene)
            elif current_scene is not None:
                current_scene["text"].append(label)
        elif in_section and current_scene is not None:
            current_scene["text"].append(event[1])

    if not scenes:
        fail("Codex Radar homepage has no recognizable Station Picks section")

    model_effort_pattern = re.compile(
        r"(?P<model>[A-Za-z0-9][A-Za-z0-9._-]*(?:[ \t]+[A-Za-z0-9][A-Za-z0-9._-]*)*)"
        r"[ \t]+(?P<effort>[A-Za-z][A-Za-z0-9_-]{0,23})",
        re.IGNORECASE,
    )
    raw_recommendations = []
    for scene in scenes:
        text = re.sub(r"[\u00a0\u3000]+", " ", "\n".join(scene["text"]))
        items = []
        seen = set()
        for line in text.splitlines():
            line = line.strip(" \t\n.,;:|/()[]{}·")
            for segment in re.split(r"\s*(?:/|·|;|；|\||,|，)\s*", line):
                fast = bool(re.search(r"(?i)(?:\s*[+＋]\s*|\s+)fast\b", segment))
                segment = re.sub(r"(?i)(?:\s*[+＋]\s*|\s+)(?:fast|ultrafast)\b", " ", segment)
                match = model_effort_pattern.fullmatch(segment.strip())
                if not match:
                    continue
                model = match.group("model").strip(" \t\n.,;:|/()[]{}")
                effort = match.group("effort").lower()
                if (not model or effort in ("fast", "ultrafast")
                        or not any(character.isalpha() for character in model)
                        or not any(character.isdigit() for character in model)):
                    continue
                identity = (re.sub(r"\s+", "-", model.lower()), effort)
                if identity in seen:
                    continue
                seen.add(identity)
                items.append({"model": model, "effort": effort, "fast": fast})
        if not items:
            continue
        key = re.sub(r"[^a-z0-9]+", "_", scene["title"].lower()).strip("_")
        key = key[:64].strip("_")
        if not key:
            key = "scene-" + hashlib.sha256(scene["title"].encode("utf-8")).hexdigest()[:12]
        raw_recommendations.append({"key": key, "title": scene["title"], "items": items})

    if not raw_recommendations:
        fail("Codex Radar homepage Station Picks contained no recognizable model/effort values")
    normalized = normalize_codex_radar(raw_recommendations)
    if not normalized["items"]:
        fail("Codex Radar homepage Station Picks contained no usable model/effort values")
    return normalized


class CodexRadarTradeoffsParser(HTMLParser):
    """Read the published data for the same cohort as the trade-off table."""
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.collecting = False
        self.payloads = []

    def handle_starttag(self, tag, attrs):
        if tag == "script" and any(key == "data-mtr-payload" for key, _ in attrs):
            self.collecting = True
            self.payloads.append([])

    def handle_endtag(self, tag):
        if tag == "script":
            self.collecting = False

    def handle_data(self, data):
        if self.collecting:
            self.payloads[-1].append(data)


def normalize_codex_radar_tradeoffs(document):
    parser = CodexRadarTradeoffsParser()
    parser.feed(document)
    parser.close()
    if len(parser.payloads) != 1:
        fail("Codex Radar trade-off data is missing or ambiguous")
    payload = json.loads("".join(parser.payloads[0]))
    if not isinstance(payload, dict) or payload.get("schema") != "codex-model-tradeoffs/2":
        fail("Unsupported Codex Radar trade-off schema")
    definition = payload.get("composite_definition")
    if (not isinstance(definition, dict) or definition.get("time_exponent") != 2
            or definition.get("reference_usd") != 1 or definition.get("reference_minutes") != 10):
        fail("Unsupported Codex Radar composite cost definition")
    if not all(isinstance(payload.get(key), str) and payload[key] for key in ("round_id", "protocol")):
        fail("Codex Radar trade-off data has no batch identity")
    source_rows = payload.get("rows")
    if not isinstance(source_rows, list):
        fail("Codex Radar trade-off data has no rows")
    if len(source_rows) > 512:
        fail("Codex Radar trade-off data exceeds the 512-row limit")
    rows = []
    seen = set()
    for row in source_rows:
        if not isinstance(row, dict):
            continue
        model, effort = row.get("model"), row.get("effort")
        metrics, availability = row.get("chart_metrics"), row.get("availability")
        if (not isinstance(model, str) or not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,63}", model)
                or not isinstance(effort, str) or not re.fullmatch(r"[a-z][a-z0-9_]{0,23}", effort)
                or not isinstance(metrics, dict) or not isinstance(availability, dict)
                or availability.get("cost") is not True or availability.get("time") is not True
                or availability.get("composite") is not True):
            continue
        score = metrics.get("score150")
        cost = metrics.get("api_equivalent_usd_per_task")
        minutes = metrics.get("end_to_end_minutes_per_task")
        published_composite = metrics.get("composite_cost_index")
        if (any(type(value) not in (int, float) or not math.isfinite(value)
                for value in (score, cost, minutes, published_composite))
                or not 0 <= score <= 150 or cost < 0 or minutes <= 0 or published_composite < 0):
            continue
        try:
            composite = cost * (minutes / 10) ** 2
        except OverflowError:
            continue
        if not math.isfinite(composite) or not math.isclose(composite, published_composite, rel_tol=1e-6, abs_tol=1e-12):
            continue
        pair = (model, effort)
        if pair in seen:
            fail("Codex Radar trade-off data contains duplicate model/effort pairs")
        seen.add(pair)
        rows.append({"model": model, "effort": effort, "score150": score,
                     "cost_usd_per_task": cost, "minutes_per_task": minutes})
    if len(rows) < 2:
        fail("Codex Radar trade-off data contains fewer than two comparable rows")
    return {"schema": payload["schema"], "round_id": payload["round_id"],
            "protocol": payload["protocol"], "composite_definition": definition, "rows": rows}


def codex_radar_composite(row):
    try:
        return row["cost_usd_per_task"] * (row["minutes_per_task"] / 10) ** 2
    except OverflowError:
        return math.inf


def codex_radar_log_ratio(value, reference):
    # Avoid overflow in value/reference while retaining accuracy near zero.
    if value <= reference:
        return math.log1p(value / reference)
    return math.log(value) - math.log(reference) + math.log1p(reference / value)


def codex_radar_frontier(rows, measure):
    """The site's strict 2D Pareto rule: maximize score, minimize measure."""
    return [a for a in rows if not any(
        measure(b) <= measure(a) and b["score150"] >= a["score150"]
        and (measure(b) < measure(a) or b["score150"] > a["score150"])
        for b in rows)]


def rank_codex_radar_tradeoffs(benchmark, catalog=None, allowed_pairs=None):
    """Rank complete, comparable rows; a worker can further restrict the candidates."""
    if not isinstance(benchmark, dict) or not isinstance(benchmark.get("rows"), list):
        return []
    catalog = catalog or {}
    rows = []
    for row in benchmark["rows"]:
        if not isinstance(row, dict):
            continue
        model, effort = row.get("model"), row.get("effort")
        score, cost, minutes = row.get("score150"), row.get("cost_usd_per_task"), row.get("minutes_per_task")
        if (not isinstance(model, str) or not isinstance(effort, str)
                or any(type(value) not in (int, float) or not math.isfinite(value) for value in (score, cost, minutes))
                or not 0 <= score <= 150 or cost < 0 or minutes <= 0):
            continue
        if not math.isfinite(codex_radar_composite(row)):
            continue
        pair = (model_key(model), effort)
        if allowed_pairs is not None and pair not in allowed_pairs:
            continue
        metadata = catalog.get(pair[0]) if catalog else None
        if catalog and not isinstance(metadata, dict):
            continue
        levels = metadata.get("supported_reasoning_levels") if metadata else None
        if isinstance(levels, list) and effort not in {entry.get("effort") for entry in levels if isinstance(entry, dict)}:
            continue
        rows.append(row)
    if not rows:
        return []

    site_axes = {"cost": lambda row: row["cost_usd_per_task"],
                 "time": lambda row: row["minutes_per_task"],
                 "composite": codex_radar_composite}
    site_frontiers = {name: {(row["model"], row["effort"]) for row in codex_radar_frontier(rows, measure)}
                      for name, measure in site_axes.items()}
    best_score = max(row["score150"] for row in rows)
    profiles = read(CONFIG / "recommendation-profiles.json")["profiles"]
    items = []
    for profile in profiles:
        floor = best_score * profile["min_quality_ratio"]
        weights = profile["weights"]
        def scene_cost(row):
            cost = codex_radar_log_ratio(row["cost_usd_per_task"], 0.01) / math.log1p(100)
            duration = math.log1p(row["minutes_per_task"]) / math.log1p(10)
            composite = codex_radar_log_ratio(codex_radar_composite(row), 0.01) / math.log1p(100)
            return weights["cost"] * cost + weights["time"] * duration + weights["composite"] * composite

        eligible = [row for row in rows if row["score150"] >= floor]
        scene_costs = {id(row): scene_cost(row) for row in eligible}
        frontier = codex_radar_frontier(eligible, lambda row: scene_costs[id(row)])
        candidates = [(weights["quality"] * row["score150"] / 150.0 - scene_costs[id(row)], row)
                      for row in frontier]
        candidates.sort(key=lambda item: (-item[0], -item[1]["score150"], item[1]["cost_usd_per_task"],
                                          item[1]["minutes_per_task"], item[1]["model"], item[1]["effort"]))
        if not candidates:
            continue
        utility, winner = candidates[0]
        model, effort = winner["model"], winner["effort"]
        suffix = hashlib.sha256((profile["id"] + "\0" + model + "\0" + effort).encode()).hexdigest()[:10]
        metrics = {key: winner[key] for key in ("score150", "cost_usd_per_task", "minutes_per_task")}
        metrics["composite_cost_index"] = codex_radar_composite(winner)
        verified = bool(catalog and isinstance(levels_for(catalog, model), list))
        label = (f"{profile['label']} · {model} {effort} · 算法(四题参考) "
                 f"{metrics['score150']:.1f}/150 ${metrics['cost_usd_per_task']:.4g}/题 "
                 f"{metrics['minutes_per_task']:.1f}分/题"
                 + (" · 可用性未验证" if not verified else ""))
        items.append({"id": "profile-" + profile["id"] + "-" + suffix,
                      "source_key": profile["id"], "scene": profile["label"], "label": label,
                      "model": model, "effort": effort, "fast": False, "method": "measured_pareto_v3",
                      "metrics": metrics, "selection_score": round(utility, 6),
                      "quality_floor": round(floor, 4), "weights": weights,
                      "scene_cost": scene_costs[id(winner)],
                      "site_frontiers": [name for name in site_axes if (model, effort) in site_frontiers[name]],
                      "catalog_verified": verified,
                      "alternatives": [{"model": choice["model"], "effort": choice["effort"],
                                        "score150": choice["score150"],
                                        "cost_usd_per_task": choice["cost_usd_per_task"],
                                        "minutes_per_task": choice["minutes_per_task"]}
                                       for _, choice in candidates[1:3]]})
    return items


def levels_for(catalog, model):
    metadata = catalog.get(model_key(model), {})
    return metadata.get("supported_reasoning_levels") if isinstance(metadata, dict) else None


def read_codex_radar_cache(path=None):
    path = Path(path) if path else codex_radar_cache_path()
    try:
        cache = read(path)
    except (OSError, ValueError, TypeError):
        return None
    if not isinstance(cache, dict):
        return None
    if cache.get("version") == 1:
        # Drop the old hard-coded scene map but retain the failed-attempt
        # timestamp and diagnostic so migration does not erase useful status.
        cache = dict(cache)
        cache.pop("scenes", None)
        cache["version"] = 2
        cache["recommendations"] = {"items": []}
    if cache.get("version") != 2:
        return None
    if (cache.get("source_url") == "https://codexradar.com/api/radar-insights"
            and cache.get("source_format") == "html"
            and cache.get("fetched_from_url") == "https://codexradar.com/"):
        cache["source_url"] = cache["fetched_from_url"]
        cache["last_attempt_url"] = cache["fetched_from_url"]
        cache.pop("source_warning", None)
    if not isinstance(cache.get("recommendations"), dict):
        return None
    return cache


def codex_radar_fetch(opener, url, accept):
    request = urllib.request.Request(
        url,
        headers={
            "Accept": accept,
            "User-Agent": "agent-team/1 Codex-Radar-recommendations",
            "Origin": "https://codexradar.com",
            "Referer": "https://codexradar.com/",
        },
    )
    with opener.open(request, timeout=4) as response:
        body = response.read(8 * 1024 * 1024 + 1)
    if len(body) > 8 * 1024 * 1024:
        fail("Codex Radar response exceeds the 8 MiB limit")
    return body


def codex_radar_error_detail(url, error):
    if isinstance(error, urllib.error.HTTPError):
        detail = "HTTPError:" + str(error.code)
    elif isinstance(error, RuntimeError):
        detail = str(error)
    else:
        detail = type(error).__name__
    return codex_radar_url_label(url) + " (" + detail + ")"


def codex_radar_attempt_time(cache):
    value = cache.get("last_attempt_at", cache.get("fetched_at", 0)) if cache else 0
    return value if type(value) in (int, float) and math.isfinite(value) else 0


def codex_radar_data_time(cache):
    value = cache.get("fetched_at") if cache else None
    if type(value) in (int, float) and math.isfinite(value):
        return value
    return 0 if cache and cache.get("last_error") else codex_radar_attempt_time(cache)


def merge_codex_radar_caches(options, candidates):
    matches = [cache for cache in candidates if cache and cache.get("source_url") == options["url"]]
    if not matches:
        return None
    latest_data = max(enumerate(matches), key=lambda pair: (codex_radar_data_time(pair[1]), pair[0]))[1]
    latest_attempt = max(enumerate(matches), key=lambda pair: (codex_radar_attempt_time(pair[1]), pair[0]))[1]
    if latest_attempt.get("last_error") and codex_radar_attempt_time(latest_attempt) > codex_radar_attempt_time(latest_data):
        latest_data = dict(latest_data, last_error=latest_attempt["last_error"],
                           last_attempt_at=codex_radar_attempt_time(latest_attempt),
                           last_attempt_url=latest_attempt.get("last_attempt_url", options["url"]))
    return latest_data


def newest_codex_radar_cache(options):
    # A successful staged fetch must remain the base for a later retry, even
    # if the user has not opened the menu to promote it yet.
    candidates = (read_codex_radar_cache(), read_codex_radar_cache(codex_radar_pending_cache_path()))
    return merge_codex_radar_caches(options, candidates)


def update_codex_radar_recommendations(force=False, strict=False, target="active"):
    if target not in ("active", "pending"):
        fail("Codex Radar cache target must be active or pending")
    options = codex_radar_options()
    now = time.time()
    cache = newest_codex_radar_cache(options) if target == "pending" else read_codex_radar_cache()
    if cache and cache.get("source_url") != options["url"]:
        cache = None
    interval = options.get("refresh_interval_seconds", 86400)
    last_attempt = cache.get("last_attempt_at", cache.get("fetched_at", 0)) if cache else 0
    if not isinstance(last_attempt, (int, float)):
        last_attempt = 0
    last_attempt_url = cache.get("last_attempt_url", cache.get("source_url")) if cache else None
    if not force and cache and last_attempt_url == options["url"] and now - last_attempt < interval:
        return cache, False

    request_environment = environment({})
    proxies = {
        scheme: request_environment.get(scheme + "_proxy") or request_environment.get(scheme.upper() + "_PROXY")
        for scheme in ("http", "https")
    }
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({k: v for k, v in proxies.items() if v}))
    catalog = None
    try:
        body = codex_radar_fetch(opener, options["url"], "text/html,application/xhtml+xml")
        document = body.decode("utf-8")
        try:
            station_recommendations = normalize_codex_radar_html(document, options)
        except (ValueError, TypeError, KeyError, RuntimeError):
            station_recommendations = {"items": []}
        try:
            benchmark = normalize_codex_radar_tradeoffs(document)
            source_warning = None
        except (ValueError, TypeError, KeyError, RuntimeError) as error:
            if cache and isinstance(cache.get("benchmark"), dict):
                fail("Trade-off data unavailable; retaining last measured batch: " + type(error).__name__)
            benchmark = None
            source_warning = "Trade-off data unavailable; using station picks: " + type(error).__name__
        if benchmark:
            catalog = cached_codex_model_catalog(refresh=True)
            recommendations = {"items": rank_codex_radar_tradeoffs(benchmark, catalog)}
            if not recommendations["items"]:
                source_warning = "No measured model/effort pairs match the local Codex catalog"
        else:
            recommendations = station_recommendations
        if not recommendations["items"] and not benchmark and not station_recommendations["items"]:
            fail("Codex Radar homepage contains no usable trade-off data or station picks")
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError, UnicodeError, ValueError, TypeError, KeyError, RuntimeError) as error:
        error_summary = codex_radar_error_detail(options["url"], error)
        if strict:
            fail("CodexRadar refresh failed: " + error_summary)
        if cache is None:
            cache = {"version": 2, "source_url": options["url"], "fetched_at": None,
                     "recommendations": {"items": []}}
        cache["last_attempt_at"] = now
        cache["last_attempt_url"] = options["url"]
        cache["last_error"] = error_summary
        try:
            cache_path = codex_radar_pending_cache_path() if target == "pending" else codex_radar_cache_path()
            cache_path.parent.mkdir(parents=True, exist_ok=True)
            write(cache_path, cache)
        except OSError:
            pass
        return cache, False

    cache = {
        "version": 2,
        "source_url": options["url"],
        "last_attempt_url": options["url"],
        "fetched_at": now,
        "source_updated_at": None,
        "last_attempt_at": now,
        "fetched_from_url": options["url"],
        "source_format": "html",
        "recommendations": recommendations,
        "station_recommendations": station_recommendations,
        "benchmark": benchmark,
        "source_warning": source_warning,
        "model_catalog": compact_codex_model_catalog(catalog) if catalog is not None else None,
        "catalog_warning": ("Current Codex model catalog unavailable; model availability is unverified"
                            if benchmark and not catalog else None),
    }
    try:
        cache_path = codex_radar_pending_cache_path() if target == "pending" else codex_radar_cache_path()
        cache_path.parent.mkdir(parents=True, exist_ok=True)
        write(cache_path, cache)
    except OSError:
        if strict:
            raise
        return cache, False
    return cache, True


def codex_radar_has_data(cache):
    recommendations = cache.get("recommendations", {}) if cache else {}
    items = recommendations.get("items") if isinstance(recommendations, dict) else None
    return isinstance(items, list) and bool(items)


def codex_radar_refresh_lock_path():
    return codex_radar_cache_path().with_name("codexradar-recommendations.refresh.lock")


def acquire_codex_radar_refresh_lock():
    cache_path = codex_radar_cache_path()
    lock_path = codex_radar_refresh_lock_path()
    try:
        cache_path.parent.mkdir(parents=True, exist_ok=True)
    except OSError:
        return False
    for _ in range(2):
        try:
            descriptor = os.open(lock_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            try:
                if time.time() - lock_path.stat().st_mtime > 600:
                    lock_path.unlink()
                    continue
            except OSError:
                pass
            return False
        except OSError:
            return False
        try:
            os.write(descriptor, str(os.getpid()).encode("ascii"))
        except OSError:
            try:
                lock_path.unlink()
            except OSError:
                pass
            return False
        finally:
            os.close(descriptor)
        return True
    return False


def release_codex_radar_refresh_lock():
    try:
        codex_radar_refresh_lock_path().unlink()
    except FileNotFoundError:
        pass


def start_codex_radar_background_refresh():
    if not acquire_codex_radar_refresh_lock():
        return False
    try:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "__refresh-codex-radar"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=environment({}),
            close_fds=True,
            start_new_session=True,
        )
    except OSError:
        release_codex_radar_refresh_lock()
        return False
    return True


def run_codex_radar_background_refresh():
    try:
        update_codex_radar_recommendations(force=True, target="pending")
    finally:
        release_codex_radar_refresh_lock()


def codex_radar_refresh_due(cache, options, now):
    has_data = codex_radar_has_data(cache)
    interval = options.get("refresh_interval_seconds", 86400)
    retry_interval = (options.get("failure_retry_interval_seconds", 300)
                      if not has_data or (cache and (cache.get("last_error") or cache.get("source_warning")))
                      else interval)
    items = cache.get("recommendations", {}).get("items", []) if has_data else []
    missing_fast = any(not isinstance(item.get("fast"), bool) for item in items if isinstance(item, dict))
    needs_upgrade = bool(cache and "benchmark" not in cache)
    return (not cache or ((missing_fast or needs_upgrade) and not cache.get("last_error"))
            or now - codex_radar_attempt_time(cache) >= retry_interval)


def sync_codex_radar_if_due(force=False):
    # Also used by an external timer. Never replace the active menu snapshot
    # while a user might be selecting one of its IDs.
    if not acquire_codex_radar_refresh_lock():
        return {"status": "busy"}
    try:
        options = codex_radar_options()
        cache = newest_codex_radar_cache(options)
        if not force and not codex_radar_refresh_due(cache, options, time.time()):
            return {"status": "not_due"}
        cache, updated = update_codex_radar_recommendations(force=True, target="pending")
        if not updated:
            return {"status": "failed", "error": cache.get("last_error", "could not save Radar data")}
        return {"status": "updated", "fetched_at": cache.get("fetched_at")}
    finally:
        release_codex_radar_refresh_lock()


def promote_codex_radar_pending(options):
    pending_path = codex_radar_pending_cache_path()
    claimed_path = pending_path.with_name(pending_path.name + "." + uuid.uuid4().hex + ".claimed")
    try:
        # Claim exactly one generation. A concurrent writer can safely publish
        # a newer pending file while this one is being promoted.
        pending_path.replace(claimed_path)
    except OSError:
        return read_codex_radar_cache()
    keep_claimed = False
    try:
        pending = read_codex_radar_cache(claimed_path)
        active = read_codex_radar_cache()
        if active and active.get("source_url") != options["url"]:
            active = None
        selected = merge_codex_radar_caches(options, (active, pending))
        if selected and selected != active:
            try:
                write(codex_radar_cache_path(), selected)
                active = selected
            except OSError:
                try:
                    # Do not overwrite a newer pending generation.
                    os.link(claimed_path, pending_path)
                except FileExistsError:
                    pass
                except OSError:
                    keep_claimed = True
                    raise
        return active
    finally:
        if not keep_claimed:
            claimed_path.unlink(missing_ok=True)


def prepare_codex_radar_for_menu():
    options = codex_radar_options()
    cache = promote_codex_radar_pending(options)
    if cache and cache.get("source_url") != options["url"]:
        cache = None
    if cache is None:
        cache, _ = update_codex_radar_recommendations(force=True)
        return cache

    # Workbench reads this file directly. Recompute against the current local
    # catalog before returning, and publish the same IDs used by the launcher.
    if isinstance(cache.get("benchmark"), dict):
        catalog = cached_codex_model_catalog(refresh=True)
        calculated = {"items": rank_codex_radar_tradeoffs(cache["benchmark"], catalog)}
        compact_catalog = compact_codex_model_catalog(catalog)
        catalog_warning = ("Current Codex model catalog unavailable; model availability is unverified"
                           if not catalog else None)
        no_match_warning = "No measured model/effort pairs match the local Codex catalog"
        warning = cache.get("source_warning")
        if not calculated["items"]:
            warning = no_match_warning
        elif warning == no_match_warning:
            warning = None
        if (calculated != cache.get("recommendations") or warning != cache.get("source_warning")
                or compact_catalog != cache.get("model_catalog") or catalog_warning != cache.get("catalog_warning")):
            cache = dict(cache, recommendations=calculated, source_warning=warning,
                         model_catalog=compact_catalog, catalog_warning=catalog_warning)
            try:
                write(codex_radar_cache_path(), cache)
            except OSError:
                pass

    has_data = codex_radar_has_data(cache)
    if codex_radar_refresh_due(cache, options, time.time()):
        if has_data:
            start_codex_radar_background_refresh()
        else:
            cache, _ = update_codex_radar_recommendations(force=True)
    return cache


def apply_codex_radar_recommendation(target, recommendation, key, updated_at, team_roles=True):
    target["model"] = recommendation["model"]
    target["effort"] = recommendation["effort"]
    if isinstance(recommendation.get("fast"), bool):
        target["fast"] = recommendation["fast"]
        target["fast_explicit"] = True
    if team_roles:
        target["worker_model"] = recommendation["model"]
        target["worker_effort"] = recommendation["effort"]
        target.pop("lead_model", None)
        target.pop("lead_effort", None)
    target["recommendation_source"] = "codexradar.com"
    target["recommendation_key"] = recommendation.get("source_key", key)
    target["recommendation_updated_at"] = updated_at
    if recommendation.get("method"):
        target["recommendation_method"] = recommendation["method"]
        target["recommendation_metrics"] = recommendation.get("metrics")


def recommendation_timestamp(cache):
    if cache.get("source_updated_at"):
        return str(cache["source_updated_at"])
    fetched_at = cache.get("fetched_at")
    if isinstance(fetched_at, (int, float)):
        return time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(fetched_at))
    return None


def codex_radar_command(argv):
    parser = argparse.ArgumentParser(prog="agent-team recommendations")
    parser.add_argument("action", choices=("status", "refresh", "prepare", "sync", "schedule"))
    parser.add_argument("schedule_action", nargs="?", choices=("enable", "disable", "status"))
    parser.add_argument("--force", action="store_true", help="fetch now when using sync")
    args = parser.parse_args(argv)
    if args.force and args.action != "sync":
        parser.error("--force is only valid with sync")
    if args.action == "schedule":
        if not args.schedule_action:
            parser.error("schedule requires enable, disable or status")
        sys.path.insert(0, str(ROOT))
        import radar_scheduler
        if args.schedule_action == "enable":
            result = radar_scheduler.enable(Path(__file__).resolve(), Path(sys.executable).resolve(), os.environ)
        elif args.schedule_action == "disable":
            result = radar_scheduler.disable(os.environ)
        else:
            result = radar_scheduler.status(os.environ)
        print(json.dumps(result, ensure_ascii=False))
        return
    if args.schedule_action:
        parser.error("an extra argument is only valid with schedule")
    if args.action == "refresh":
        cache, _ = update_codex_radar_recommendations(force=True, strict=True)
        try:
            codex_radar_pending_cache_path().unlink()
        except FileNotFoundError:
            pass
    elif args.action == "prepare":
        prepare_codex_radar_for_menu()
        return
    elif args.action == "sync":
        result = sync_codex_radar_if_due(force=args.force)
        # The two sources have separate caches and failure states: a bad
        # benchmark fetch must never erase or block the Radar menu snapshot.
        result["terminal_bench"] = sync_terminal_bench(force=args.force)
        print(json.dumps(result, ensure_ascii=False))
        if result["status"] == "failed":
            fail("CodexRadar scheduled refresh failed: " + result["error"])
        return
    else:
        cache = read_codex_radar_cache()
    options = codex_radar_options()
    cache_matches_source = bool(cache and cache.get("source_url") == options["url"])
    failed_endpoint = None
    if cache and cache.get("last_error"):
        endpoint = cache.get("last_attempt_url") or cache.get("source_url")
        if isinstance(endpoint, str):
            failed_endpoint = codex_radar_url_label(endpoint)
    result = {
        "source": options["url"],
        "cache_source": cache.get("source_url") if cache else None,
        "cache_needs_refresh": not cache_matches_source or not codex_radar_has_data(cache),
        "cache_file": str(codex_radar_cache_path()),
        "updated_at": recommendation_timestamp(cache) if cache_matches_source else None,
        "fetched_from_url": cache.get("fetched_from_url") if cache_matches_source else None,
        "source_format": cache.get("source_format") if cache_matches_source else None,
        "source_warning": cache.get("source_warning") if cache_matches_source else None,
        "catalog_warning": cache.get("catalog_warning") if cache_matches_source else None,
        "recommendations": cache.get("recommendations", {}) if cache_matches_source else {},
        "station_recommendations": cache.get("station_recommendations", {}) if cache_matches_source else {},
        "benchmark": cache.get("benchmark") if cache_matches_source else None,
        "last_error": cache.get("last_error") if cache else None,
        "last_error_endpoint": failed_endpoint,
    }
    pending = read_codex_radar_cache(codex_radar_pending_cache_path())
    if pending and pending.get("source_url") == options["url"]:
        result["pending_refresh"] = {
            "updated_at": recommendation_timestamp(pending),
            "last_attempt_at": codex_radar_attempt_time(pending),
            "last_error": pending.get("last_error"),
            "source_warning": pending.get("source_warning"),
        }
    print(json.dumps(result, ensure_ascii=False, indent=2))


def terminal_bench_module():
    if str(ROOT) not in sys.path:
        sys.path.insert(0, str(ROOT))
    # A scheduled refresh should not leave interpreter caches in the checkout.
    old_bytecode_setting = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        import terminal_bench
    finally:
        sys.dont_write_bytecode = old_bytecode_setting
    return terminal_bench


def sync_terminal_bench(force=False):
    module = terminal_bench_module()
    request_environment = environment({})
    proxies = {
        scheme: request_environment.get(scheme + "_proxy") or request_environment.get(scheme.upper() + "_PROXY")
        for scheme in ("http", "https")
    }
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({k: v for k, v in proxies.items() if v}))
    try:
        return module.sync(force=force, opener=opener)
    except OSError as exc:
        return {"status": "failed", "error": type(exc).__name__}


def coding_benchmark_command(argv):
    parser = argparse.ArgumentParser(prog="agent-team benchmarks")
    parser.add_argument("action", choices=("status", "refresh"))
    args = parser.parse_args(argv)
    module = terminal_bench_module()
    if args.action == "refresh":
        refresh = sync_terminal_bench(force=True)
        if refresh["status"] == "failed":
            fail("Terminal-Bench refresh failed: " + refresh["error"])
        if refresh["status"] != "updated":
            fail("Terminal-Bench refresh is already in progress")
    cache = module.read_cache()
    benchmark = cache.get("benchmark") if cache else None
    catalog = cached_codex_model_catalog(refresh=True) if isinstance(benchmark, dict) else None
    ranked = module.rank(benchmark, catalog) if isinstance(benchmark, dict) else []
    measured = {(row["model"], row["effort"]) for row in benchmark.get("rows", [])} if benchmark else set()
    missing = []
    for model, metadata in sorted((catalog or {}).items()):
        if not model.startswith("gpt-") or not isinstance(metadata, dict):
            continue
        for level in metadata.get("supported_reasoning_levels", []):
            effort = level.get("effort") if isinstance(level, dict) else None
            if isinstance(effort, str) and (model, effort) not in measured:
                missing.append({"model": model, "effort": effort})
    print(json.dumps({
        "source": module.SOURCE,
        "board": module.BOARD,
        "cache_file": str(module.cache_path()),
        "fetched_at": cache.get("fetched_at") if cache else None,
        "last_attempt_at": cache.get("last_attempt_at") if cache else None,
        "last_error": cache.get("last_error") if cache else None,
        "catalog_verified": bool(catalog),
        "method": LEGACY_RECOMMENDATION_METHOD,
        "scope": "Coding-terminal evidence only; computer automation is not measured",
        "unmeasured_catalog_pairs": missing,
        "profiles": ranked,
        "computer_automation": {"status": "not_measured_by_terminal_bench",
                                "reason": "See recommendations status for the separate desktop sources"},
    }, ensure_ascii=False, indent=2))


LEGACY_RECOMMENDATION_METHOD = "terminal-bench-4.1-pareto-v1"
RECOMMENDATION_METHOD = "scenario-multisource-v2"


def extra_benchmarks_module():
    terminal_bench_module()  # Add the repository root before imports.
    old_bytecode_setting = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        import benchmark_sources
    finally:
        sys.dont_write_bytecode = old_bytecode_setting
    return benchmark_sources


def scenario_engine_module():
    terminal_bench_module()
    old_bytecode_setting = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        import scenario_engine
    finally:
        sys.dont_write_bytecode = old_bytecode_setting
    return scenario_engine


def scenario_profiles():
    profiles = read(CONFIG / "scenario-profiles.json")
    if not isinstance(profiles, dict) or profiles.get("version") != 1 or not isinstance(profiles.get("scenes"), list):
        fail("Invalid scenario recommendation profiles")
    names = set()
    for profile in profiles["scenes"]:
        if (not isinstance(profile, dict) or profile.get("id") in names
                or not isinstance(profile.get("label"), str) or not profile.get("id")):
            fail("Invalid scenario recommendation profile")
        names.add(profile["id"])
        axes = profile.get("axes")
        if axes is not None and (not isinstance(axes, dict) or not axes or
                any(key not in ("backend", "frontend", "knowledge") or type(value) not in (int, float)
                    or not math.isfinite(value) or value < 0 for key, value in axes.items()) or
                abs(sum(axes.values()) - 1) > 1e-9):
            fail("Scenario axis weights must add to one")
        for role in ("lead", "worker"):
            settings = profile.get(role)
            if role == "lead" and profile.get("source") == "terminal_bench":
                continue
            if (not isinstance(settings, dict) or any(type(settings.get(key)) not in (int, float)
                    or not math.isfinite(settings[key]) or settings[key] < 0 for key in ("cost", "time"))):
                fail("Scenario cost and time weights must be nonnegative numbers")
    for key in ("modeldial_close_points", "desktop_close_points"):
        if type(profiles.get(key)) not in (int, float) or not math.isfinite(profiles[key]) or profiles[key] < 0:
            fail("Scenario close-call margins must be nonnegative numbers")
    return profiles


def sync_extra_benchmarks(names=None, force=False):
    import concurrent.futures
    module = extra_benchmarks_module()
    names = list(module.SOURCES) if names is None else list(names)
    request_environment = environment({})
    proxies = {scheme: request_environment.get(scheme + "_proxy") or request_environment.get(scheme.upper() + "_PROXY")
               for scheme in ("http", "https")}

    def fetch(name):
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({k: v for k, v in proxies.items() if v}))
        try:
            return module.sync(name, force=force, opener=opener)
        except OSError as exc:
            return {"status": "failed", "error": type(exc).__name__}

    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, len(names))) as pool:
        return dict(zip(names, pool.map(fetch, names)))


def source_evidence():
    terminal = terminal_bench_module().read_cache()
    extra = extra_benchmarks_module()
    caches = {"terminal_bench": terminal, **{name: extra.read_cache(name) for name in extra.SOURCES}}
    benchmarks = {name: cache["benchmark"] for name, cache in caches.items()
                  if isinstance(cache, dict) and isinstance(cache.get("benchmark"), dict)}
    status = {name: {"fetched_at": cache.get("fetched_at"), "last_error": cache.get("last_error"),
                     "last_attempt_at": cache.get("last_attempt_at")}
              if isinstance(cache, dict) else {"fetched_at": None, "last_error": None}
              for name, cache in caches.items()}
    return benchmarks, status


def sync_all_benchmarks(force=False):
    import concurrent.futures
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
        terminal = pool.submit(sync_terminal_bench, force=force)
        extra = pool.submit(sync_extra_benchmarks, force=force)
        results = {"terminal_bench": terminal.result(), **extra.result()}
    states = [value.get("status") for value in results.values()]
    state = ("failed" if all(value == "failed" for value in states) else
             "partial" if "failed" in states else "updated" if "updated" in states else
             "busy" if "busy" in states else "not_due")
    return {"status": state, "sources": results}


def recommendation_cache_path():
    return Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "agent-team/recommendations.json"


def read_recommendation_cache():
    try:
        cache = read(recommendation_cache_path())
        return cache if isinstance(cache, dict) and cache.get("version") == 2 else None
    except (OSError, ValueError, TypeError):
        return None


def recommendation_items(cache):
    if not isinstance(cache, dict):
        return []
    items = cache.get("recommendations", {}).get("items", [])
    return [item for item in items if isinstance(item, dict) and all(
        isinstance(item.get(key), str) and item[key] for key in ("id", "model", "effort"))] if isinstance(items, list) else []


def worker_pairs_for_lead(benchmark, lead, policy=None):
    """Filter measured pairs using the same combined ceiling as team policy."""
    policy = policy if policy is not None else model_policy_config()
    lead_tier = model_tier(lead["model"], policy)
    lead_rank = policy["thinking_levels"].get(lead["effort"])
    if lead_rank is None:
        return set()
    pairs = set()
    for row in benchmark.get("rows", []):
        if not isinstance(row, dict):
            continue
        model, effort = row.get("model"), row.get("effort")
        if not isinstance(model, str) or not isinstance(effort, str):
            continue
        tier, rank = model_tier(model, policy), policy["thinking_levels"].get(effort)
        if rank is None:
            continue
        if lead_tier is None:
            eligible = model_key(model) == model_key(lead["model"]) and rank <= lead_rank
        else:
            eligible = tier is not None and tier * 10 + rank <= lead_tier * 10 + lead_rank
        if eligible:
            pairs.add((model, effort))
    return pairs


def calculate_recommendations(benchmark, catalog, fetched_at=None):
    """Calculate both roles from one immutable evidence and catalog snapshot."""
    module = terminal_bench_module()
    policy = model_policy_config()
    valid_leads = {(r["model"], r["effort"]) for r in benchmark.get("rows", [])
                   if isinstance(r, dict) and isinstance(r.get("model"), str)
                   and isinstance(r.get("effort"), str) and model_tier(r["model"], policy) is not None
                   and r["effort"] in policy["thinking_levels"]}
    fingerprint = hashlib.sha256(json.dumps({"method": LEGACY_RECOMMENDATION_METHOD, "benchmark": benchmark,
                                              "catalog": catalog, "policy": policy,
                                              "lead_profiles": module.PROFILES,
                                              "worker_profiles": module.WORKER_PROFILES},
                                             sort_keys=True).encode()).hexdigest()[:12]
    items = []
    for profile in module.rank(benchmark, catalog, valid_leads, role="lead"):
        lead = profile["candidates"][0]
        workers = module.rank(benchmark, catalog, worker_pairs_for_lead(benchmark, lead, policy), role="worker")
        worker_profile = next((p for p in workers if p["scene"] == profile["scene"]), None)
        if not worker_profile:
            continue
        worker = worker_profile["candidates"][0]
        items.append({"id": profile["scene"] + "-" + fingerprint,
                      "source_key": profile["scene"],
                      "label": profile["label"] + " · " + lead["model"] + " / " + lead["effort"],
                      "model": lead["model"], "effort": lead["effort"],
                      "worker_model": worker["model"], "worker_effort": worker["effort"],
                      "fast": False, "method": LEGACY_RECOMMENDATION_METHOD,
                      "metrics": {"lead": profile, "worker": worker_profile}})
    return {"version": 2, "source_url": module.SOURCE, "method": LEGACY_RECOMMENDATION_METHOD,
            "snapshot_id": fingerprint, "fetched_at": fetched_at, "benchmark": benchmark,
            "model_catalog": catalog, "model_policy": policy, "catalog_verified": bool(catalog),
            "recommendations": {"items": items},
            "unavailable_scenes": [{"key": "computer", "label": "电脑自动化",
                                    "reason": "缺少同一桌面自动化基准的成本和耗时数据"}]}


def calculate_scenario_recommendations(sources, catalog, source_status=None):
    engine = scenario_engine_module()
    profiles = scenario_profiles()
    policy = model_policy_config()
    all_rows = [row for benchmark in sources.values() if isinstance(benchmark, dict)
                for row in benchmark.get("rows", []) if isinstance(row, dict)
                and isinstance(row.get("model"), str) and isinstance(row.get("effort"), str)]
    valid_pairs = {(row["model"], row["effort"]) for row in all_rows
                   if model_tier(row["model"], policy) is not None
                   and row["effort"] in policy["thinking_levels"]}
    terminal_profiles = {"lead": terminal_bench_module().PROFILES,
                         "worker": terminal_bench_module().WORKER_PROFILES}
    fingerprint = hashlib.sha256(json.dumps({"method": RECOMMENDATION_METHOD, "sources": sources,
                                             "catalog": catalog, "policy": policy, "profiles": profiles,
                                             "terminal_profiles": terminal_profiles},
                                            sort_keys=True).encode()).hexdigest()[:12]
    items, unavailable = [], []
    for profile in profiles["scenes"]:
        lead_profile = engine.rank_scene(profile, sources, "lead", profiles, catalog, valid_pairs)
        if not lead_profile:
            unavailable.append({"key": profile["id"], "label": profile["label"],
                                "reason": "缺少可比较的实测数据或本地支持档位"})
            continue
        lead = lead_profile["candidates"][0]
        allowed = worker_pairs_for_lead({"rows": all_rows}, lead, policy)
        worker_profile = engine.rank_scene(profile, sources, "worker", profiles, catalog, allowed)
        if not worker_profile and profile["source"] == "terminal_bench":
            fallback = dict(profile, worker_source="terminal_bench")
            worker_profile = engine.rank_scene(fallback, sources, "worker", profiles, catalog, allowed)
        if not worker_profile:
            unavailable.append({"key": profile["id"], "label": profile["label"],
                                "reason": "主档位下缺少可比较的工作档位"})
            continue
        worker = worker_profile["candidates"][0]
        suggestions = []
        for subtask in profiles["scenes"]:
            ranked = engine.rank_scene(subtask, sources, "worker", profiles, catalog, allowed)
            if ranked:
                choice = ranked["candidates"][0]
                suggestions.append({"id": subtask["id"], "label": subtask["label"],
                                    "model": choice["model"], "effort": choice["effort"],
                                    "source": ranked["source"]})
        items.append({"id": profile["id"] + "-" + fingerprint, "source_key": profile["id"],
                      "label": profile["label"] + " · " + lead["model"] + " / " + lead["effort"],
                      "model": lead["model"], "effort": lead["effort"],
                      "worker_model": worker["model"], "worker_effort": worker["effort"],
                      "worker_recommendations": suggestions, "source_url": lead_profile["source_url"],
                      "fast": False, "method": RECOMMENDATION_METHOD,
                      "metrics": {"lead": lead_profile, "worker": worker_profile}})
    return {"version": 2, "method": RECOMMENDATION_METHOD, "snapshot_id": fingerprint,
            "sources": sources, "source_status": source_status or {}, "profiles": profiles,
            "terminal_profiles": terminal_profiles,
            "model_catalog": catalog, "model_policy": policy, "catalog_verified": bool(catalog),
            "recommendations": {"items": items}, "unavailable_scenes": unavailable,
            "attribution": {"modeldial": "ModelDial Public Radar; CC BY 4.0; calculations modified",
                            "url": "https://modeldial.com/radar",
                            "license": "https://creativecommons.org/licenses/by/4.0/"}}


def prepare_recommendations(fetch_if_missing=True):
    sources, status = source_evidence()
    if fetch_if_missing:
        missing = [name for name in extra_benchmarks_module().SOURCES if name not in sources]
        if "terminal_bench" not in sources:
            sync_terminal_bench()
        if missing:
            sync_extra_benchmarks(missing)
        sources, status = source_evidence()
    catalog = compact_codex_model_catalog(cached_codex_model_catalog(refresh=True)) if sources else {}
    cache = calculate_scenario_recommendations(sources, catalog, status)
    # Keep old menu IDs resolvable while another menu is open. Scheduled source
    # updates do not publish menu snapshots; only preparation does so.
    import fcntl
    path = recommendation_cache_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(str(path) + ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        old = read_recommendation_cache()
        history = old.get("history", []) if isinstance(old, dict) else []
        history = [entry for entry in history if isinstance(entry, dict)] if isinstance(history, list) else []
        if old and old.get("snapshot_id") != cache["snapshot_id"] and recommendation_items(old):
            history.insert(0, {key: old.get(key) for key in
                               ("snapshot_id", "fetched_at", "benchmark", "sources", "source_status", "profiles", "terminal_profiles",
                                "model_catalog", "model_policy", "recommendations")})
        cache["history"] = [entry for entry in history if entry.get("snapshot_id") != cache["snapshot_id"]][:12]
        write(path, cache)
    return cache


def recommendation_settings(recommendation_id=None, team=False, cache=None):
    cache = cache if cache is not None else (CODEX_RADAR_MENU_CACHE or read_recommendation_cache())
    snapshot, item = None, None
    for candidate in ([cache] + (cache.get("history", []) if isinstance(cache, dict) else [])):
        selected = next((entry for entry in recommendation_items(candidate) if entry["id"] == recommendation_id), None)
        if selected:
            snapshot, item = candidate, selected
            break
    if recommendation_id and item is None:
        fail("Recommendation expired or unavailable; reopen the menu to select a current recommendation")
    cfg = codex_settings(team=team, cache={})
    if item:
        timestamp = recommendation_timestamp(snapshot)
        if item.get("method") == RECOMMENDATION_METHOD:
            source = item.get("metrics", {}).get("lead", {}).get("source")
            source_names = ("cua_osworld", "cua_osworld2") if source == "cua" else (source,)
            status = snapshot.get("source_status", {})
            times = [status.get(name, {}).get("fetched_at") for name in source_names
                     if isinstance(status.get(name), dict)]
            times = [value for value in times if type(value) in (int, float) and math.isfinite(value)]
            if times:
                timestamp = time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(min(times)))
        cfg.update(model=item["model"], effort=item["effort"], fast=item.get("fast", False),
                   fast_explicit=True, recommendation_id=item["id"], recommendation_key=item["source_key"],
                   recommendation_source=item.get("source_url", terminal_bench_module().SOURCE),
                   recommendation_method=item["method"],
                   recommendation_metrics=item["metrics"], recommendation_updated_at=timestamp)
        if team:
            cfg.update(worker_model=item["worker_model"], worker_effort=item["worker_effort"],
                       worker_catalog=snapshot.get("model_catalog", {}))
            if item["method"] == RECOMMENDATION_METHOD:
                cfg["worker_recommendations"] = item.get("worker_recommendations", [])
            else:
                cfg["worker_benchmark"] = snapshot.get("benchmark")
    return cfg


def recommendation_command(argv):
    parser = argparse.ArgumentParser(prog="agent-team recommendations")
    parser.add_argument("action", choices=("status", "refresh", "prepare", "sync", "schedule"))
    parser.add_argument("schedule_action", nargs="?", choices=("enable", "disable", "status"))
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args(argv)
    if args.force and args.action != "sync":
        parser.error("--force is only valid with sync")
    if args.action == "schedule":
        if not args.schedule_action:
            parser.error("schedule requires enable, disable or status")
        sys.path.insert(0, str(ROOT))
        import radar_scheduler
        if args.schedule_action == "enable":
            result = radar_scheduler.enable(Path(__file__).resolve(), Path(sys.executable).resolve(), os.environ)
        elif args.schedule_action == "disable":
            result = radar_scheduler.disable(os.environ)
        else:
            result = radar_scheduler.status(os.environ)
        print(json.dumps(result, ensure_ascii=False))
        return
    if args.schedule_action:
        parser.error("an extra argument is only valid with schedule")
    if args.action == "sync":
        result = sync_all_benchmarks(force=args.force)
        print(json.dumps(result, ensure_ascii=False))
        if result["status"] == "failed":
            fail("All benchmark refreshes failed")
        return
    if args.action == "refresh":
        result = sync_all_benchmarks(force=True)
        if result["status"] == "failed":
            fail("All benchmark refreshes failed")
        if result["status"] == "busy":
            fail("Benchmark refresh is already in progress")
    if args.action == "prepare":
        prepare_recommendations()
        return
    cache = prepare_recommendations(fetch_if_missing=False)
    # Historical generations are used only to resolve existing menu choices.
    print(json.dumps({key: value for key, value in cache.items() if key != "history"}, ensure_ascii=False, indent=2))


SCENE_LABELS = {"daily": "日常开发", "hard": "复杂攻坚", "batch": "批量执行"}


def model_key(model):
    if not isinstance(model, str):
        return ""
    value = model.strip().lower().replace("‑", "-").replace("–", "-")
    if "/" in value:
        value = value.rsplit("/", 1)[-1]
    return re.sub(r"[^a-z0-9.]+", "-", value).strip("-")


def model_tier(model, policy):
    key = model_key(model)
    tier = policy["model_tiers"].get(key)
    if tier is not None:
        return tier
    for family, tier in sorted(policy["model_families"].items(), key=lambda item: len(item[0]), reverse=True):
        if key == family or key.endswith("-" + family):
            return tier
    return None


def model_policy_config():
    policy = read(CONFIG / "model-levels.json")
    if not isinstance(policy, dict):
        fail("Built-in model policy must be a JSON object")
    override = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-team/model-levels.json"
    if override.exists():
        custom = read(override)
        if not isinstance(custom, dict):
            fail("Custom model policy must be a JSON object")
        policy_keys = {"model_tiers", "model_families", "thinking_levels",
                       "default_thinking_level", "latest_models"}
        if not (policy_keys & custom.keys()):
            # Continue to accept the original {model: level} override format.
            custom = {"model_tiers": custom}
        merge(policy, custom)

    tiers = policy.get("model_tiers")
    if not isinstance(tiers, dict):
        fail("model_tiers must map model names to positive integers")
    normalized_tiers = {}
    for name, level in tiers.items():
        if not isinstance(name, str) or not name or type(level) is not int or level < 1:
            fail("model_tiers must map model names to positive integers")
        key = model_key(name)
        if not key:
            fail("model_tiers keys must contain a model name")
        normalized_tiers[key] = level

    families = policy.get("model_families", {})
    if not isinstance(families, dict):
        fail("model_families must map model-family suffixes to positive integers")
    normalized_families = {}
    for name, level in families.items():
        if not isinstance(name, str) or not name or type(level) is not int or level < 1:
            fail("model_families must map model-family suffixes to positive integers")
        key = model_key(name)
        if not re.fullmatch(r"[a-z][a-z0-9-]*", key) or key in normalized_families:
            fail("model_families keys must be unique family names")
        normalized_families[key] = level
    for key, level in normalized_tiers.items():
        for family, family_level in normalized_families.items():
            if (key == family or key.endswith("-" + family)) and level != family_level:
                fail("Model tier conflicts with its configured family: " + key)

    thinking = policy.get("thinking_levels")
    if not isinstance(thinking, dict) or not thinking:
        fail("thinking_levels must map effort names to positive integer ranks")
    normalized_thinking = {}
    for name, rank in thinking.items():
        if not isinstance(name, str) or not name or type(rank) is not int or not 1 <= rank <= 9:
            fail("thinking_levels must map effort names to integer ranks from 1 to 9")
        key = name.strip().lower()
        if not key or key in normalized_thinking:
            fail("thinking_levels must contain unique nonempty effort names")
        normalized_thinking[key] = rank
    if len(set(normalized_thinking.values())) != len(normalized_thinking):
        fail("thinking_levels ranks must be unique")
    default_effort = policy.get("default_thinking_level")
    if not isinstance(default_effort, str) or default_effort.strip().lower() not in normalized_thinking:
        fail("default_thinking_level must name an entry in thinking_levels")

    latest = policy.get("latest_models", {})
    if not isinstance(latest, dict):
        fail("latest_models must map tool names to model arrays")
    normalized_latest = {}
    for tool, models in latest.items():
        if not isinstance(tool, str) or not tool or not isinstance(models, list) or not all(
                isinstance(model, str) and model for model in models):
            fail("latest_models must map tool names to arrays of model names")
        seen_tiers = set()
        seen_models = set()
        for model in models:
            key = model_key(model)
            tier = model_tier(model, {
                "model_tiers": normalized_tiers,
                "model_families": normalized_families,
            })
            if tier is None:
                fail("Latest model has no configured tier: " + model)
            if key in seen_models or tier in seen_tiers:
                fail("latest_models must contain only one model per tier for " + tool)
            seen_models.add(key)
            seen_tiers.add(tier)
        normalized_latest[tool] = models
    return {"model_tiers": normalized_tiers, "model_families": normalized_families,
            "thinking_levels": normalized_thinking,
            "default_thinking_level": default_effort.strip().lower(), "latest_models": normalized_latest}


def thinking_rank(effort, policy):
    name = (effort or policy["default_thinking_level"]).strip().lower()
    rank = policy["thinking_levels"].get(name)
    if rank is None:
        fail("Thinking level has no configured rank: " + name
             + "; add it to config/model-levels.json")
    return rank


def display_level(level):
    return str(level // 10) + "." + str(level % 10)


def validate_model_ceiling(main_model, main_effort, subagent_model, subagent_effort):
    subagent_model = subagent_model or main_model
    policy = model_policy_config()
    if not subagent_model:
        main_rank = thinking_rank(main_effort, policy)
        subagent_rank = thinking_rank(subagent_effort or main_effort, policy)
        if subagent_rank > main_rank:
            fail("Subagent thinking level exceeds the lead: "
                 + (subagent_effort or main_effort or policy["default_thinking_level"])
                 + " > " + (main_effort or policy["default_thinking_level"]))
        return
    if not main_model:
        fail("Cannot enforce the subagent model ceiling without an explicit lead model")
    main_key, subagent_key = model_key(main_model), model_key(subagent_model)
    main_tier = model_tier(main_model, policy)
    subagent_tier = model_tier(subagent_model, policy)
    subagent_effort = subagent_effort or main_effort
    main_rank = thinking_rank(main_effort, policy)
    subagent_rank = thinking_rank(subagent_effort, policy)
    if main_key == subagent_key and main_tier is None:
        if subagent_rank > main_rank:
            fail("Subagent thinking level exceeds the lead: " + (subagent_effort or policy["default_thinking_level"])
                 + " > " + (main_effort or policy["default_thinking_level"]))
        return
    if main_tier is None:
        fail("Lead model has no configured level: " + main_model
             + "; add it to config/model-levels.json or use the same model for workers")
    if subagent_tier is None:
        fail("Subagent model has no configured level: " + subagent_model
             + "; add it to config/model-levels.json")
    main_level = main_tier * 10 + main_rank
    subagent_level = subagent_tier * 10 + subagent_rank
    if subagent_level > main_level:
        fail("Subagent combined level exceeds the lead: " + subagent_model + " "
             + display_level(subagent_level) + " > " + main_model + " " + display_level(main_level))


def latest_models_by_tier(policy, tool):
    candidates = list(policy["latest_models"].get(tool, []))
    if tool == "codex":
        cache = CODEX_RADAR_MENU_CACHE or read_recommendation_cache()
        candidates.extend(item["model"] for item in recommendation_items(cache))
    latest = {}
    for order, model in enumerate(candidates):
        tier = model_tier(model, policy)
        if tier is None:
            continue
        version = codex_radar_model_version(model)
        current = latest.get(tier)
        if current is None or (version, order) > (current["version"], current["order"]):
            latest[tier] = {"model": model, "version": version, "order": order}
    return {tier: value["model"] for tier, value in latest.items()}


def latest_worker_config(cfg, tool):
    result = dict(cfg)
    # A measured recommendation pins its exact worker pair and evidence.
    if result.get("recommendation_method") in (RECOMMENDATION_METHOD, LEGACY_RECOMMENDATION_METHOD):
        return result
    policy = model_policy_config()
    current = result.get("worker_model") or result.get("model")
    if not current:
        return result
    tier = model_tier(current, policy)
    if tier is None:
        return result
    latest = latest_models_by_tier(policy, tool)
    if tier in latest:
        result["worker_model"] = latest[tier]
    return result


def cached_codex_model_catalog(refresh=False):
    try:
        if refresh:
            # Let the selected CLI validate its own provider, identity and
            # client version. A shared models_cache.json may belong to a
            # different Codex process and is not a safe fallback here.
            result = subprocess.run(["codex", "debug", "models"], stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                    text=True, timeout=4, env=environment({}))
            if result.returncode or len(result.stdout) > 8 * 1024 * 1024:
                return {}
            models = json.loads(result.stdout).get("models", [])
        else:
            path = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))) / "models_cache.json"
            models = read(path).get("models", [])
        return {model_key(model["slug"]): model for model in models
                if isinstance(model, dict) and isinstance(model.get("slug"), str)}
    except (OSError, ValueError, TypeError, AttributeError, subprocess.TimeoutExpired):
        return {}


def compact_codex_model_catalog(catalog):
    """Retain only model metadata needed by launch and worker policy."""
    result = {}
    for model, metadata in catalog.items():
        if not isinstance(model, str) or not isinstance(metadata, dict):
            continue
        entry = {}
        levels = metadata.get("supported_reasoning_levels")
        if isinstance(levels, list):
            entry["supported_reasoning_levels"] = [
                {"effort": level["effort"]} for level in levels
                if isinstance(level, dict) and isinstance(level.get("effort"), str)]
        tiers = metadata.get("additional_speed_tiers")
        if isinstance(tiers, list):
            entry["additional_speed_tiers"] = [tier for tier in tiers if isinstance(tier, str)]
        description = metadata.get("description")
        if isinstance(description, str):
            entry["description"] = description[:4096]
        result[model] = entry
    return result


def model_policy(cfg, tool, mode):
    main_model = cfg.get("model")
    if cfg.get("recommendation_method") not in (RECOMMENDATION_METHOD, LEGACY_RECOMMENDATION_METHOD):
        cfg = latest_worker_config(cfg, tool)
    policy = model_policy_config()
    lead_effort = cfg.get("effort") or policy["default_thinking_level"]
    default_model = cfg.get("worker_model") or main_model
    default_effort = cfg.get("worker_effort") or lead_effort
    main_tier = model_tier(main_model, policy) if main_model else None
    lead_rank = thinking_rank(lead_effort, policy)
    lead_level = main_tier * 10 + lead_rank if main_tier is not None else None

    latest = latest_models_by_tier(policy, tool)
    if latest:
        candidates = [latest[tier] for tier in sorted(latest)]
    else:
        candidates = list(dict.fromkeys(model for model in (default_model, main_model) if model))
    if tool == "codex" and cfg.get("recommendation_method") == LEGACY_RECOMMENDATION_METHOD:
        # Older measured pairs remain comparable candidates, not just the most
        # recent model in each family. Availability and the ceiling still apply.
        worker_benchmark = cfg.get("worker_benchmark")
        worker_benchmark = worker_benchmark if isinstance(worker_benchmark, dict) else {}
        candidates = list(dict.fromkeys(candidates + [row["model"] for row in
            worker_benchmark.get("rows", []) if isinstance(row, dict)
            and isinstance(row.get("model"), str)]))
    if tool == "codex" and cfg.get("recommendation_method") == RECOMMENDATION_METHOD:
        candidates = list(dict.fromkeys(candidates + [item["model"] for item in
            cfg.get("worker_recommendations", []) if isinstance(item, dict)
            and isinstance(item.get("model"), str)] + [model for model in (default_model, main_model) if model]))
    worker_catalog = cfg.get("worker_catalog")
    catalog = (worker_catalog if isinstance(worker_catalog, dict) else cached_codex_model_catalog()) if tool == "codex" else {}
    model_descriptions = {}
    allowed_settings = []
    allowed_models = []
    for candidate in candidates:
        if isinstance(worker_catalog, dict) and catalog and model_key(candidate) not in catalog:
            continue
        tier = model_tier(candidate, policy)
        if main_tier is None:
            if model_key(candidate) != model_key(main_model):
                continue
            effort_ranks = [(name, rank) for name, rank in policy["thinking_levels"].items() if rank <= lead_rank]
        elif tier is None or tier > main_tier:
            continue
        else:
            effort_ranks = [(name, rank) for name, rank in policy["thinking_levels"].items()
                            if tier * 10 + rank <= lead_level]
        metadata = catalog.get(model_key(candidate), {})
        supported = {entry.get("effort") for entry in metadata.get("supported_reasoning_levels", [])
                     if isinstance(entry, dict)}
        if supported:
            effort_ranks = [(name, rank) for name, rank in effort_ranks if name in supported]
        description = metadata.get("description")
        if isinstance(description, str) and description.strip():
            model_descriptions[candidate] = description.strip()
        if not any(model_key(candidate) == model_key(model) for model in allowed_models):
            allowed_models.append(candidate)
        for effort, rank in sorted(effort_ranks, key=lambda item: item[1]):
            level = (tier * 10 + rank) if tier is not None else rank
            allowed_settings.append({"model": candidate, "effort": effort,
                                     "level": display_level(level) if tier is not None else effort})
    default_tier = model_tier(default_model, policy) if default_model else None
    if default_model and default_tier is not None:
        default_level = display_level(default_tier * 10 + thinking_rank(default_effort, policy))
    elif default_model:
        default_level = default_effort
    else:
        default_level = None
    dynamic = mode == "tmux" or (mode == "native" and tool == "codex")
    # Recommendations are advisory, and only exact pairs within the same
    # allowed set may be offered. Unknown or over-ceiling entries are omitted.
    allowed_pairs = {(model_key(item["model"]), item["effort"]) for item in allowed_settings}
    worker_items = cfg.get("worker_recommendations", [])
    if tool == "codex" and isinstance(cfg.get("worker_benchmark"), dict):
        if cfg.get("recommendation_method") == LEGACY_RECOMMENDATION_METHOD:
            profiles = terminal_bench_module().rank(cfg["worker_benchmark"], catalog, allowed_pairs, role="worker")
            worker_items = [{"id": p["scene"], "label": p["label"], **p["candidates"][0]} for p in profiles]
        else:
            worker_items = rank_codex_radar_tradeoffs(cfg["worker_benchmark"], catalog, allowed_pairs)
    recommendations = [
        {"scene": item.get("label", item["id"]), "model": item["model"], "effort": item["effort"]}
        for item in worker_items
        if (model_key(item["model"]), item["effort"]) in allowed_pairs
    ] if tool == "codex" else []
    return {
        "task_recommendations": recommendations,
        "model_descriptions": model_descriptions,
        "lead_model": main_model,
        "lead_effort": lead_effort,
        "lead_level": display_level(lead_level) if lead_level is not None else None,
        "default_worker_model": default_model,
        "default_worker_effort": default_effort,
        "default_worker_level": default_level,
        "allowed_worker_models": allowed_models,
        "allowed_worker_settings": allowed_settings,
        "select_per_task": dynamic and len(allowed_settings) > 1,
    }


def scene_names(tool="codex"):
    if tool == "codex":
        return ()
    return tuple(read(CONFIG / "teams.json")[tool]["scenes"])


def has_tier_pair(value, model_key="model", effort_key="effort"):
    return (isinstance(value.get(model_key), str) and bool(value[model_key])
            and isinstance(value.get(effort_key), str) and bool(value[effort_key]))


def codex_radar_model_version(model):
    match = re.search(r"\d+(?:\.\d+)*", model)
    return tuple(int(part) for part in match.group(0).split(".")) if match else ()


def codex_radar_items(cache=None):
    if cache is None:
        if not CODEX_RADAR_RUNTIME:
            return []
        cache = CODEX_RADAR_MENU_CACHE if CODEX_RADAR_MENU_CACHE is not None else read_codex_radar_cache()
    if not isinstance(cache, dict):
        return []
    try:
        options = codex_radar_options()
        if cache.get("source_url") != options["url"]:
            return []
    except (OSError, ValueError, TypeError, KeyError, RuntimeError):
        return []
    recommendations = cache.get("recommendations", {})
    items = recommendations.get("items", []) if isinstance(recommendations, dict) else []
    return [item for item in items if isinstance(item, dict)
            and isinstance(item.get("id"), str)
            and isinstance(item.get("model"), str)
            and isinstance(item.get("effort"), str)] if isinstance(items, list) else []


def codex_radar_menu_items(cache=None):
    items = codex_radar_items(cache)
    try:
        limit = codex_radar_options().get("menu_category_limit")
    except (OSError, ValueError, TypeError, KeyError, RuntimeError):
        return []
    categories = {}
    for item in items:
        category = item.get("source_key")
        if not isinstance(category, str) or not category:
            category = item["id"]
        categories.setdefault(category, []).append(item)

    selected = []
    for choices in list(categories.values())[:limit]:
        _, newest = max(enumerate(choices), key=lambda choice: (
            codex_radar_model_version(choice[1]["model"]), choice[0]))
        selected.append(newest)
    return selected


def codex_settings(recommendation_id=None, team=False, cache=None):
    if cache is None and CODEX_RADAR_RUNTIME:
        cache = CODEX_RADAR_MENU_CACHE if CODEX_RADAR_MENU_CACHE is not None else read_codex_radar_cache()
    value = {"fast": False}
    recommendation = next((item for item in codex_radar_items(cache)
                           if item["id"] == recommendation_id), None) if recommendation_id else None
    if recommendation:
        apply_codex_radar_recommendation(
            value, recommendation, recommendation.get("source_key", recommendation_id),
            recommendation_timestamp(cache), team_roles=team,
        )
    value.update(recommendation_id=recommendation_id if recommendation else None)
    if team:
        # Keep the exact launch-time cache snapshot so task routing is coherent
        # with the recommendation chosen for the lead.
        value["worker_recommendations"] = codex_radar_items(cache)
        if isinstance(cache, dict) and isinstance(cache.get("benchmark"), dict):
            value["worker_benchmark"] = cache["benchmark"]
        if isinstance(cache, dict) and isinstance(cache.get("model_catalog"), dict):
            value["worker_catalog"] = cache["model_catalog"]
        override = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-team/config.json"
        if override.exists():
            personal = read(override).get("codex", {}).get("team", {})
            if "limit" in personal:
                value["limit"] = personal["limit"]
    value.setdefault("limit", 4)
    if type(value["limit"]) is not int or not 1 <= value["limit"] <= 8:
        fail("Team limit must be an integer from 1 to 8")
    value.setdefault("yolo", team)
    return value


def scene_settings(scene=None, team=False, adjustment=None, tool="codex"):
    if tool == "codex":
        return codex_settings(recommendation_id=scene, team=team)
    config = read(CONFIG / "teams.json")[tool]
    if scene not in config["scenes"]:
        fail("Unknown " + tool + " scene: " + str(scene))
    value = dict(config["scenes"][scene])
    override = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-team/config.json"
    if override.exists():
        personal = read(override).get(tool, {})
        merge(value, personal.get("scenes", {}).get(scene, {}))
    allowed = {"model", "effort", "lead_model", "lead_effort", "worker_model", "worker_effort", "fast", "limit", "yolo", "args", "worker_args", "env"}
    if set(value) - allowed:
        fail("Unknown scene settings: " + ", ".join(sorted(set(value) - allowed)))
    for key in ("args", "worker_args"):
        if key in value and (not isinstance(value[key], list) or not all(isinstance(arg, str) for arg in value[key])):
            fail("Scene " + key + " must be an array of CLI arguments")
    if "env" in value and (not isinstance(value["env"], dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in value["env"].items())):
        fail("Scene env must map string names to string values")
    value.setdefault("fast", False)
    if not isinstance(value["fast"], bool):
        fail("Scene fast must be a boolean")
    for key in ("model", "effort", "worker_model", "worker_effort"):
        if not isinstance(value.get(key), str) or not value[key]:
            fail("Scene " + key + " must be a nonempty string")
    for key in ("lead_model", "lead_effort"):
        if key in value and (not isinstance(value[key], str) or not value[key]):
            fail("Scene " + key + " must be a nonempty string")
    if team:
        value["model"], value["effort"] = value.get("lead_model", value["model"]), value.get("lead_effort", value["effort"])
        value = latest_worker_config(value, tool)
    if adjustment:
        if adjustment != "quick":
            fail("Unknown temporary adjustment: " + adjustment)
        adjustment_value = config.get("adjustments", {}).get(adjustment)
        if not isinstance(adjustment_value, dict):
            fail("Unknown " + tool + " adjustment: " + adjustment)
        value.update(adjustment_value)
    value.update(scene=scene, adjustment=adjustment)
    value.setdefault("limit", 4)
    value.setdefault("yolo", team)
    if not isinstance(value["yolo"], bool):
        fail("Scene yolo must be a boolean")
    if type(value["limit"]) is not int or not 1 <= value["limit"] <= 8:
        fail("Team limit must be an integer from 1 to 8")
    return value


def validate_scene_models(cfg, team=False, tool="codex"):
    if tool == "traex":
        result = subprocess.run(["traex", "debug", "models"], capture_output=True, text=True, env=environment(cfg), timeout=30)
        if result.returncode:
            fail("Trae model catalog is unavailable; no fallback will be selected")
        models = json.loads(result.stdout).get("models", [])
        catalog = {alias: model for model in models for alias in (model.get("slug"), model.get("config_name")) if alias}
        return validate_catalog(cfg, team, catalog)
    if not has_tier_pair(cfg):
        return
    current = cached_codex_model_catalog(refresh=True)
    if not current:
        fail("Codex model catalog is unavailable; cannot validate the selected recommendation")
    catalog = {model.get("slug", key): model for key, model in current.items()}
    return validate_catalog(cfg, team, catalog)


def validate_catalog(cfg, team, catalog):
    roles = [(cfg["model"], cfg["effort"])] if has_tier_pair(cfg) else []
    if team and has_tier_pair(cfg, "worker_model", "worker_effort"):
        roles.append((cfg["worker_model"], cfg["worker_effort"]))
    for model, effort in roles:
        available = catalog.get(model)
        if not available:
            fail("Configured model is unavailable: " + model + "; no fallback will be selected")
        levels = {level["effort"] for level in available.get("supported_reasoning_levels", [])}
        if effort not in levels:
            fail("Configured reasoning effort is unavailable: " + model + " / " + effort)
        if cfg["fast"] and "fast" not in available.get("additional_speed_tiers", []):
            fail("Configured scene Fast mode is unavailable for " + model)


def start_codex(argv, tool="codex"):
    parser = argparse.ArgumentParser(prog="agent-team start " + tool)
    if tool == "codex":
        parser.add_argument("--recommendation", "--scene", dest="recommendation")
    else:
        parser.add_argument("--scene", choices=scene_names(tool), default="daily")
        parser.add_argument("--adjust", choices=["quick"])
    parser.add_argument("--team", action="store_true")
    parser.add_argument("--tmux", action="store_true")
    parser.add_argument("--fast", action=argparse.BooleanOptionalAction, default=None)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--check", action="store_true", help="Validate scene availability without starting a session")
    permissions = parser.add_mutually_exclusive_group()
    permissions.add_argument("--yolo", dest="yolo", action="store_const", const=True, default=None)
    permissions.add_argument("--no-yolo", dest="yolo", action="store_const", const=False)
    # Unknown CLI arguments retain their order and are forwarded verbatim.
    options, extra = parser.parse_known_args(argv)
    if options.tmux and not options.team:
        fail("--tmux requires --team")
    if tool == "codex":
        cfg = recommendation_settings(options.recommendation, options.team)
    else:
        cfg = scene_settings(options.scene, options.team, options.adjust, tool=tool)
    if options.fast is not None:
        cfg["fast"] = options.fast
        cfg["fast_explicit"] = True
    if options.yolo is not None:
        cfg["yolo"] = options.yolo
    if tool == "codex" and not has_tier_pair(cfg):
        message = "Recommendation unavailable;" if options.recommendation else "No recommendation selected;"
        print("agent-team: " + message + " using Codex defaults", file=sys.stderr)
    if options.check:
        validate_scene_models(cfg, options.team, tool=tool)
        options.dry_run = True
    if options.team:
        flags = (["--tmux"] if options.tmux else []) + (["--team-dry-run"] if options.dry_run else [])
        return launch(tool, flags + extra, resolved=cfg)
    args = [tool]
    if cfg.get("model") and cfg.get("effort"):
        args += ["-m", cfg["model"], "-c", "model_reasoning_effort=" + json.dumps(cfg["effort"])]
    if tool == "codex":
        args[1:1] = ["--no-daemon"]
        if cfg.get("effort"):
            args += ["-c", "plan_mode_reasoning_effort=" + json.dumps(cfg["effort"])]
        if cfg.get("fast_explicit") or cfg.get("fast"):
            args += ["-c", "service_tier=" + json.dumps("fast" if cfg["fast"] else "default")]
        args += ["-c", "agents.enabled=false"]
    else:
        args += ["--disable", "multi_agent", "--disable", "multi_agent_v2"]
    if cfg["yolo"]:
        args.append("--yolo")
    args.extend(cfg.get("args", []))
    args.extend(extra)
    if options.dry_run:
        print(json.dumps({"tool":tool, "mode":"single",
                          "recommendation_id":cfg.get("recommendation_id") if tool == "codex" else None,
                          "scene":options.scene if tool == "traex" else None,
                          "config":cfg, "argv":args}, indent=2))
        return
    # The disk catalog can predate a model rollout. Let Codex refresh it during
    # startup; only the explicit --check diagnostic validates this cached list.
    if tool == "traex":
        validate_scene_models(cfg, tool=tool)
    if not shutil.which(tool):
        fail("CLI is not installed: " + tool)
    env = {key:value for key,value in environment(cfg).items() if not key.startswith("AGENT_TEAM_")}
    return os.execvpe(tool, args, env)


def start_simple(argv, tool):
    """Launch infrequently used tools without imposing a model scene."""
    parser = argparse.ArgumentParser(prog="agent-team start " + tool, allow_abbrev=False)
    parser.add_argument("--team", action="store_true")
    parser.add_argument("--tmux", action="store_true")
    parser.add_argument("--scene")
    parser.add_argument("--adjust", choices=["quick"])
    parser.add_argument("--fast", action=argparse.BooleanOptionalAction, default=None)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--no-yolo", action="store_true")
    options, extra = parser.parse_known_args(argv)
    if options.tmux and not options.team:
        fail("--tmux requires --team")
    if options.scene is not None or options.adjust is not None or options.fast is not None:
        print(tool + ": scene/adjust/Fast options are not applied; using tool defaults", file=sys.stderr)
    if options.check and not shutil.which(tool):
        fail("CLI is not installed: " + tool)
    if options.team:
        cfg = settings(tool, False)
        if options.no_yolo:
            cfg["yolo"] = False
        flags = (["--tmux"] if options.tmux else [])
        if options.dry_run or options.check:
            flags.append("--team-dry-run")
        return launch(tool, flags + extra, resolved=cfg)
    cfg = {"env": read(CONFIG / "teams.json")[tool].get("env", {})}
    args = [tool] + extra
    if options.dry_run or options.check:
        print(json.dumps({"tool": tool, "mode": "single", "config": cfg, "argv": args}, indent=2))
        return
    if not shutil.which(tool):
        fail("CLI is not installed: " + tool)
    env = {key: value for key, value in environment(cfg).items() if not key.startswith("AGENT_TEAM_")}
    return os.execvpe(tool, args, env)


def settings(tool, budget, expert=False):
    if tool == "codex":
        if budget or expert:
            fail("Codex budget/expert presets were removed; select a recommendation with --recommendation ID")
        return scene_settings(team=True)
    config = read(CONFIG / "teams.json")
    if expert and tool != "codex":
        fail("Expert preset is only available for Codex")
    preset = "expert" if expert else "budget" if budget else "team"
    value = config[tool][preset].copy()
    if config[tool].get("env"):
        value["env"] = dict(config[tool]["env"])
    override = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-team/config.json"
    if override.exists():
        personal = read(override).get(tool, {})
        if personal.get("env"):
            value.setdefault("env", {})
            merge(value["env"], personal["env"])
        merge(value, personal.get(preset, {}))
    value.setdefault("yolo", True)
    if not isinstance(value["yolo"], bool):
        fail("yolo must be a boolean")
    value.setdefault("limit", 4)
    if type(value["limit"]) is not int or not 1 <= value["limit"] <= 8:
        fail("Team limit must be an integer from 1 to 8")
    for key in ("model", "effort", "worker_model", "worker_effort"):
        if value.get(key) is not None and not isinstance(value[key], str):
            fail(f"{key} must be a string or null")
    for key in ("args", "worker_args"):
        if key in value and (not isinstance(value[key], list) or not all(isinstance(v, str) for v in value[key])):
            fail(f"{key} must be an array of CLI argument strings")
    if "env" in value and (not isinstance(value["env"], dict)
                           or not all(isinstance(k, str) and isinstance(v, str)
                                      for k, v in value["env"].items())):
        fail("env must be a mapping of string names to string values")
    return value


def environment(cfg):
    env = os.environ.copy()
    for key, value in cfg.get("env", {}).items():
        env.setdefault(key, value)
    for name in ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY"):
        value = env.get(name) or env.get(name.lower())
        if value:
            env.setdefault(name, value)
            env.setdefault(name.lower(), value)
    return env


def solo_settings(tool, preset):
    config = read(CONFIG / "teams.json")
    if tool not in ("codex", "traex") or preset not in config[tool].get("solo", {}):
        fail("Unsupported solo tool or preset")
    value = config[tool]["solo"][preset].copy()
    override = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-team/config.json"
    if override.exists():
        merge(value, read(override).get(tool, {}).get("solo", {}).get(preset, {}))
    for key in ("model", "effort"):
        if not isinstance(value.get(key), str) or not value[key]:
            fail(f"Solo {key} must be a nonempty string")
    if not isinstance(value.get("yolo", False), bool):
        fail("Solo yolo must be a boolean")
    return value


def solo_command(tool, preset, extra=()):
    cfg = solo_settings(tool, preset)
    args = [tool]
    if tool == "codex":
        args.append("--no-daemon")
    if cfg.get("yolo", False):
        args.append("--dangerously-bypass-approvals-and-sandbox")
    args += ["-m", cfg["model"], "-c", "model_reasoning_effort=" + json.dumps(cfg["effort"])]
    args.extend(extra)
    env = {key: value for key, value in os.environ.items() if not key.startswith("AGENT_TEAM_")}
    return args, env


def launch_solo(argv):
    if len(argv) < 2:
        fail("Usage: agent-team solo <codex|traex> <preset> [CLI args]")
    tool, preset = argv[:2]
    dry = False
    literal = False
    extra = []
    for arg in argv[2:]:
        if arg == "--":
            literal = True
        if arg == "--solo-dry-run" and not literal:
            dry = True
        else:
            extra.append(arg)
    args, env = solo_command(tool, preset, extra)
    if dry:
        print(json.dumps({"tool": tool, "mode": "solo", "preset": preset,
                          "config": solo_settings(tool, preset), "argv": args}, ensure_ascii=False, indent=2))
        return
    if not shutil.which(tool):
        fail(f"CLI is not installed: {tool}")
    return os.execvpe(tool, args, env)


def instructions(mode, worker=False, cfg=None, budget=False, expert=False, tool="codex"):
    cfg = cfg or {}
    recommendation_id = cfg.get("recommendation_id")
    scene = cfg.get("scene")
    preset = ("recommendation:" + recommendation_id + ":team" if recommendation_id else
              "scene:" + scene + ":team" if scene else
              "team-expert" if expert else "team-budget" if budget else "team")
    selected = {"recommendation_id": recommendation_id, "scene": scene,
                "fast": cfg.get("fast"), "preset": preset, "mode": mode, "limit": cfg.get("limit", 4),
                **{key: cfg.get(key) for key in ("model", "effort", "worker_model", "worker_effort")}}
    policy = model_policy(cfg, tool, mode)
    if worker:
        policy["select_per_task"] = False
    selected["model_policy"] = policy
    if policy["select_per_task"]:
        model_instruction = (
            "Choose each worker model and reasoning effort together from "
            "model_policy.allowed_worker_settings. The default worker combination is a fallback, "
            "not a fixed assignment. Set both model and reasoning_effort on each spawn "
            "when the runtime accepts them. Match the subtask to the scene labels in "
            "model_policy.task_recommendations and model_policy.model_descriptions and prefer a matching pair; distinguish simple "
            "bounded/background work from difficult reasoning and interactive work. If no scene "
            "matches, choose an allowed pair for the task rather than blindly inheriting the lead. "
            "Recommendations are hints, not guarantees of model availability or quality. "
            "Never choose a combined level above lead_level; "
            "the lead's own model and effort remain unchanged.\n"
        )
    else:
        model_instruction = (
            "Use the configured worker model and reasoning effort when delegating. Do not "
            "substitute another model or switch presets.\n"
        )
    if cfg.get("recommendation_method") == RECOMMENDATION_METHOD:
        model_instruction += (
            "The background recommendation is for small, bounded tasks with an explicit "
            "checkable result. Verify the output and escalate ambiguous or failed work to a "
            "stronger allowed model or the lead; do not assume parallel delegation is faster.\n"
        )
    common = ("Resolved configuration for THIS invocation (authoritative; do not infer it "
              "from other profiles or repository examples):\n" + json.dumps(selected, ensure_ascii=False) + "\n"
              + model_instruction
              + "Do not switch the lead's preset. For native Codex spawns, use fresh context "
              "(fork_turns=none). Leave an omitted reasoning setting inherited only when the "
              "spawn runtime cannot accept it; report unavailable model choices rather than "
              "silently falling back.\n"
              + (CONFIG / "team-rules.md").read_text())
    if worker:
        return "You are a team worker. Do not spawn agents. Follow your assigned brief.\n" + (CONFIG / "team-pane.md").read_text() + common
    marker = "Team delegation mode is enabled.\n" + common
    if mode == "tmux":
        marker += "\nPane team mode is enabled. Never use native subagents.\n" + (CONFIG / "team-pane.md").read_text()
    else:
        marker += "\nNative team mode: use native delegation only, never create panes. "
        marker += "Use team-worker when this adapter provides that agent type."
    return marker


def command(tool, cfg, mode, worker=False, extra=(), brief=None, budget=False, expert=False):
    env = environment(cfg)
    if mode == "native":
        for key in tuple(env):
            if key.startswith("AGENT_TEAM_"):
                env.pop(key)
    prompt = instructions(mode, worker, cfg, budget, expert, tool)
    if mode == "tmux" and os.environ.get("AGENT_TEAM_DIR"):
        prefix = shlex.join(["env", "AGENT_TEAM_DIR=" + os.environ["AGENT_TEAM_DIR"],
                             "AGENT_TEAM_ROLE=" + os.environ.get("AGENT_TEAM_ROLE", "lead"), "agent-team"])
        prompt += "\nYour team command prefix (also works if the tool strips inherited environment): " + prefix
        state_path = Path(os.environ["AGENT_TEAM_DIR"]) / "state.json"
        if state_path.exists() and read(state_path).get("protocol_version", 1) < 2:
            prompt += ("\nThis existing team uses the legacy pane protocol. Override the new pane "
                       "instructions: receive/wait consume messages immediately; do not use ack or "
                       "assign. Report without assignment or attempt flags, and use send for follow-up work.\n")
    model = cfg.get("worker_model", cfg.get("model")) if worker else cfg.get("model")
    effort = cfg.get("worker_effort", cfg.get("effort")) if worker else cfg.get("effort")
    disabled = mode == "tmux" or worker
    args = [tool]
    if tool == "codex":
        args.append("--no-daemon")
    yolo = cfg.get("yolo", True)
    if yolo and tool in ("codex", "traex"):
        args.append("--dangerously-bypass-approvals-and-sandbox")
    elif yolo and tool == "claude":
        args.append("--dangerously-skip-permissions")
    if tool in ("codex", "traex"):
        args += ["-c", "developer_instructions=" + json.dumps(prompt)]
        if tool == "codex":
            args += ["-c", "agents.enabled=" + ("false" if disabled else "true")]
        else:
            args += ["--disable" if disabled else "--enable", "multi_agent"]
            args += ["--disable" if disabled else "--enable", "multi_agent_v2"]
        if not disabled:
            if tool == "codex":
                args += ["-c", "agents.max_concurrent_threads_per_session=" + str(cfg["limit"])]
                for key, dest in [("worker_model", "default_subagent_model"), ("worker_effort", "default_subagent_reasoning_effort")]:
                    if cfg.get(key):
                        args += ["-c", "agents." + dest + "=" + json.dumps(cfg[key])]
            elif cfg.get("worker_model") or cfg.get("worker_effort"):
                role = 'developer_instructions = "Do not spawn agents. Return evidence and validation results."\n'
                for key, dest in [("worker_model", "model"), ("worker_effort", "model_reasoning_effort")]:
                    if cfg.get(key):
                        role += dest + " = " + json.dumps(cfg[key]) + "\n"
                cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "agent-team"
                cache.mkdir(parents=True, exist_ok=True)
                path = cache / ("traex-" + hashlib.sha256(role.encode()).hexdigest() + ".toml")
                path.write_text(role)
                args += ["-c", "agents.team-worker.description=" + json.dumps("Independent team work using the selected worker combination")]
                args += ["-c", "agents.team-worker.config_file=" + json.dumps(str(path))]
        if tool == "codex" and (cfg.get("fast_explicit") or cfg.get("fast")):
            args += ["-c", "service_tier=" + json.dumps("fast" if cfg["fast"] else "default")]
        if effort and tool == "codex":
            args += ["-c", "plan_mode_reasoning_effort=" + json.dumps(effort)]
        if model:
            args += ["-m", model]
        if effort:
            args += ["-c", "model_reasoning_effort=" + json.dumps(effort)]
    elif tool == "claude":
        env["CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS"] = "0"
        args += ["--append-system-prompt", prompt]
        if disabled:
            args += ["--disallowedTools", "Agent,Task"]
        else:
            definition = {"description": "Bounded team work; use for independent delegated tasks", "prompt": "Do not spawn agents. Return evidence and validation results.", "model": cfg.get("worker_model") or "inherit"}
            if cfg.get("worker_effort"):
                definition["effort"] = cfg["worker_effort"]
            args += ["--agents", json.dumps({"team-worker": definition})]
        if model:
            args += ["--model", model]
        if effort:
            args += ["--effort", effort]
    else:
        content = json.loads(env.get("OPENCODE_CONFIG_CONTENT", "{}"))
        lead = {"mode": "primary", "prompt": prompt}
        if model:
            lead["model"] = model
        if effort:
            lead["reasoningEffort"] = effort
        if disabled:
            lead["permission"] = {"task": "deny"}
        agents = {"team-lead": lead}
        if not disabled:
            sub = {"mode": "subagent", "description": "Bounded independent team work", "prompt": "Do not delegate. Return evidence and validation results.", "permission": {"task": "deny"}}
            if cfg.get("worker_model"):
                sub["model"] = cfg["worker_model"]
            if cfg.get("worker_effort"):
                sub["reasoningEffort"] = cfg["worker_effort"]
            agents["team-worker"] = sub
        if yolo:
            for definition in agents.values():
                definition["permission"] = {"*": "allow", **definition.get("permission", {})}
        merge(content, {"agent": agents})
        if yolo:
            # Replace stale per-agent overrides as well as the global default.
            content["permission"] = "allow"
            for name, definition in agents.items():
                content["agent"][name]["permission"] = definition["permission"]
        if disabled:
            permission = content.get("permission")
            if isinstance(permission, str):
                content["permission"] = {"*": permission, "task": "deny"}
            else:
                content.setdefault("permission", {})["task"] = "deny"
        env["OPENCODE_CONFIG_CONTENT"] = json.dumps(content)
        args += ["--agent", "team-lead"]
    args += cfg.get("worker_args" if worker else "args", [])
    args += list(extra)
    if brief:
        if tool == "opencode":
            args += ["--prompt", brief]
        else:
            args += ["--", brief]
    return args, env


def direct_command(tool, cfg, extra=(), budget=False):
    """Build a direct CLI invocation from the team/budget preset resolver."""
    args = [tool]
    if cfg.get("yolo", True):
        if tool in ("codex", "traex"):
            args.append("--yolo")
        elif tool == "claude":
            args.append("--dangerously-skip-permissions")
        elif tool == "opencode":
            args.append("--auto")
    if tool in ("codex", "traex"):
        model = cfg.get("worker_model") if budget and cfg.get("worker_model") else cfg.get("model")
        effort = cfg.get("worker_effort") if budget and cfg.get("worker_effort") else cfg.get("effort")
        if model:
            args += ["-m", model]
        if effort:
            args += ["-c", "model_reasoning_effort=" + json.dumps(effort)]
    elif tool == "claude":
        model = cfg.get("worker_model") if budget and cfg.get("worker_model") else cfg.get("model")
        effort = cfg.get("worker_effort") if budget and cfg.get("worker_effort") else cfg.get("effort")
        if model:
            args += ["--model", model]
        if effort:
            args += ["--effort", effort]
    elif tool == "opencode":
        model = cfg.get("worker_model") if budget and cfg.get("worker_model") else cfg.get("model")
        if model:
            args += ["--model", model]
    args += list(extra)
    if tool == "codex" and "--no-daemon" not in args:
        for arg in args[1:]:
            if arg == "--":
                break
            if (arg in ("-c", "--config", "--enable", "--disable", "--search")
                    or arg.startswith(("--config=", "--enable=", "--disable="))):
                args.insert(1, "--no-daemon")
                break
    return args


def run_direct(tool, argv):
    budget = False
    no_yolo = False
    forwarded = []
    literal = False
    for arg in argv:
        if arg == "--":
            literal = True
            forwarded.append(arg)
            continue
        if literal:
            forwarded.append(arg)
            continue
        if arg == "--budget":
            budget = True
        elif arg == "--no-yolo":
            no_yolo = True
        else:
            forwarded.append(arg)
    cfg = settings(tool, budget)
    if no_yolo:
        cfg["yolo"] = False
    args = direct_command(tool, cfg, forwarded, budget=budget)
    if not shutil.which(tool):
        fail(f"CLI is not installed: {tool}")
    return os.execvpe(args[0], args, environment(cfg))


def tmux_argv(*args):
    directory = os.environ.get("AGENT_TEAM_DIR")
    if directory and (Path(directory) / "state.json").exists():
        socket = read(Path(directory) / "state.json").get("socket")
        if socket:
            return ["tmux", "-S", socket, *args]
    return ["tmux", *args]


def tmux(*args, data=None, check=True):
    result = subprocess.run(tmux_argv(*args), input=data, text=True, capture_output=True)
    if check and result.returncode:
        fail(result.stderr.strip() or "tmux command failed")
    return result.stdout.strip()


def state_dir():
    value = os.environ.get("AGENT_TEAM_DIR")
    if not value:
        fail("This command must run inside a --tmux team session")
    return Path(value)


@contextlib.contextmanager
def locked(directory):
    import fcntl
    with (directory / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = read(directory / "state.json")
        yield state
        write(directory / "state.json", state)


def owned(state, pane):
    # tmux treats an empty target as its current pane, which can make every
    # historical member appear alive (and can target the wrong pane).
    if not isinstance(pane, str) or not re.fullmatch(r"%[0-9]+", pane):
        return False
    return tmux("show-options", "-p", "-v", "-t", pane, "@agent_team", check=False) == state["id"]


def layout(state):
    window = state["window"]
    sidebar = tmux("list-panes", "-t", window, "-f", "#{==:#{@pane_role},sidebar}",
                   "-F", "#{pane_id}").splitlines()
    if not sidebar:
        tmux("select-layout", "-t", window, "main-vertical")
        return
    sidebar = sidebar[0]
    width, left = map(int, tmux("display-message", "-p", "-t", sidebar,
                                "#{pane_width} #{pane_left}").split())
    active = tmux("display-message", "-p", "-t", window, "#{pane_id}")
    # Detaching the selected sidebar would interrupt the user's interaction.
    # Leave the existing split in place until a later layout operation.
    if active == sidebar:
        return
    tmux("break-pane", "-d", "-s", sidebar)
    try:
        tmux("select-layout", "-t", window, "main-vertical")
    finally:
        # Joining without -d briefly selects the sidebar and steals input.
        args = ["join-pane", "-d", "-f", "-h"]
        if left == 0:
            args.append("-b")
        try:
            tmux(*args, "-l", str(width), "-s", sidebar, "-t", window)
        except RuntimeError:
            # A concurrent resize may make the original width impossible.
            tmux(*args, "-s", sidebar, "-t", window)


def runner(directory, name):
    return shlex.join([sys.executable, str(Path(__file__).resolve()), "run-pane", str(directory), name])


def working_directory(tool, argv):
    """Normalize Codex/TraeX cwd flags once so lead and workers share one cwd."""
    cwd = Path.cwd()
    forwarded = []
    iterator = iter(argv)
    for arg in iterator:
        if arg == "--":
            forwarded.extend([arg, *iterator])
            break
        if tool in ("codex", "traex") and arg in ("-C", "--cd"):
            value = next(iterator, None)
            if value is None:
                fail(arg + " requires a directory")
            cwd = Path(value).expanduser().absolute()
        elif tool in ("codex", "traex") and (arg.startswith("--cd=") or arg.startswith("-C=")):
            cwd = Path(arg.split("=", 1)[1]).expanduser().absolute()
        else:
            forwarded.append(arg)
    if not cwd.is_dir():
        fail("Working directory does not exist: " + str(cwd))
    return str(cwd.resolve()), forwarded


def probe(state, role):
    """Read-only socket/ownership check in the calling agent's execution context."""
    if role not in state["members"]:
        fail("Unknown team member")
    pane = state["members"][role].get("pane")
    if not isinstance(pane, str) or not re.fullmatch(r"%[0-9]+", pane):
        fail("Team pane is no longer owned by this session")
    result = subprocess.run(tmux_argv("show-options", "-p", "-v", "-t",
                             pane, "@agent_team"),
                            text=True, capture_output=True)
    if result.returncode:
        fail("Team control unavailable in this execution context: " + result.stderr.strip()
             + ". Stop delegation. Use the coding CLI's normal approval mechanism for "
             "this command if permitted, or relaunch with an explicitly authorized "
             "permission configuration. No native fallback or sandbox bypass is performed.")
    if result.stdout.strip() != state["id"]:
        fail("Team pane is no longer owned by this session")
    return {"ok": True, "role": role, "cwd": state["cwd"], "config": state["config"]}


def launch(tool, argv, resolved=None):
    budget = False
    expert = False
    pane_mode = False
    dry = False
    no_yolo = False
    forwarded = []
    literal = False
    for arg in argv:
        if arg == "--":
            literal = True
            forwarded.append(arg)
            continue
        if literal:
            forwarded.append(arg)
            continue
        if arg == "--team-budget":
            budget = True
        elif arg == "--team-expert":
            expert = True
        elif arg == "--tmux":
            pane_mode = True
        elif arg == "--no-yolo":
            no_yolo = True
        elif arg == "--team-dry-run":
            dry = True
        else:
            forwarded.append(arg)
    if budget and expert:
        fail("Choose only one team preset")
    cfg = resolved if resolved is not None else settings(tool, budget, expert)
    if no_yolo:
        cfg["yolo"] = False
    cfg = latest_worker_config(cfg, tool)
    validate_model_ceiling(cfg.get("model"), cfg.get("effort"), cfg.get("worker_model"),
                           cfg.get("worker_effort"))
    mode = "tmux" if pane_mode else "native"
    forbidden = {"--remote"}
    forbidden.update({"-p", "--print", "--background", "--bg"} if tool == "claude" else {"exec", "run", "attach", "serve"})
    if pane_mode and any(x in forbidden for x in forwarded):
        fail("--tmux team mode requires a local interactive session")
    cwd = os.getcwd()
    if pane_mode:
        # Include configured arguments; otherwise -C in config would still diverge.
        cwd, combined = working_directory(tool, cfg.get("args", []) + forwarded)
        cfg = dict(cfg, args=[])
        forwarded = combined
        worker_cwd, worker_args = working_directory(tool, cfg.get("worker_args", []))
        if worker_args != cfg.get("worker_args", []) and worker_cwd != cwd:
            fail("worker_args must not select a different working directory")
        cfg["worker_args"] = worker_args
    args, env = command(tool, cfg, mode, extra=forwarded, budget=budget, expert=expert)
    if dry:
        print(json.dumps({"tool": tool, "mode": mode, "config": cfg, "cwd": cwd, "argv": args}, ensure_ascii=False, indent=2))
        return
    if tool == "traex" and cfg.get("scene"):
        validate_scene_models(cfg, team=True, tool=tool)
    if not shutil.which(tool):
        fail(f"CLI is not installed: {tool}")
    if not pane_mode:
        return os.execvpe(args[0], args, env)
    if not shutil.which("tmux"):
        fail("--tmux requires tmux")
    ident = uuid.uuid4().hex[:12]
    base = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "agent-team"
    directory = base / ident
    directory.mkdir(parents=True, mode=0o700)
    state = {"id": ident, "protocol_version": 2, "tool": tool, "config": cfg, "budget": budget, "expert": expert,
             "cwd": cwd, "extra": forwarded, "members": {}, "messages": [], "next_message": 1}
    write(directory / "state.json", state)
    shell_command = runner(directory, "lead")
    launch_environment = environment(cfg)
    tmux_environment = []
    for key in ("PATH", "CODEX_HOME", "TRAE_HOME", "XDG_CONFIG_HOME", "XDG_STATE_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "http_proxy", "https_proxy", "all_proxy", "no_proxy"):
        if key in launch_environment:
            tmux_environment += ["-e", key + "=" + launch_environment[key]]
    try:
        if os.environ.get("TMUX"):
            target = os.environ.get("TMUX_PANE")
            if not target:
                fail("TMUX_PANE is required to identify the launch window")
            session = tmux("display-message", "-p", "-t", target, "#{session_id}")
            info = tmux("new-window", "-d", "-P", "-F", "#{window_id} #{pane_id}", "-t", session, "-n", tool + "-team", "-c", state["cwd"], *tmux_environment, shell_command)
        else:
            info = tmux("new-session", "-d", "-P", "-F", "#{window_id} #{pane_id}", "-s", "team-" + ident, "-c", state["cwd"], *tmux_environment, shell_command)
        window, pane = info.split()
        with locked(directory) as state:
            state["socket"] = tmux("display-message", "-p", "-t", pane, "#{socket_path}")
            state["window"] = window
            state["members"]["lead"] = {"pane": pane, "status": "running", "cursor": 0}
            tmux("set-option", "-p", "-t", pane, "@agent_team", ident)
            tmux("set-option", "-p", "-t", pane, "@agent_team_role", "lead")
            tmux("set-option", "-w", "-t", window, "remain-on-exit", "off")
            tmux("set-option", "-w", "-t", window, "pane-border-status", "top")
            tmux("select-pane", "-t", pane, "-T", "lead")
            tmux("set-option", "-w", "-t", window, "pane-border-format", TEAM_BORDER_FORMAT)
        (directory / "ready").touch()
        if os.environ.get("TMUX"):
            tmux("select-window", "-t", window)
            print(f"Team {ident}: {window}; state: {directory}")
        else:
            subprocess.run(["tmux", "attach-session", "-t", "team-" + ident], check=True)
    except BaseException:
        (directory / "failed").touch()
        raise


def codex_preflight(args, env, cwd):
    """Exercise the controller in Codex's sandbox without an inference call."""
    options = []
    permission_profile = None
    sandbox_mode = None
    approval_policy = None
    iterator = iter(args[1:])
    for arg in iterator:
        if arg == "--":
            break
        if arg in ("-c", "--config", "-p", "--profile", "-P", "--permission-profile"):
            value = next(iterator, None)
            if value is None:
                fail(arg + " requires a value")
            options.extend([arg, value])
            if arg in ("-P", "--permission-profile"):
                permission_profile = value
        elif arg in ("-s", "--sandbox"):
            value = next(iterator, None)
            if value is None:
                fail(arg + " requires a value")
            sandbox_mode = value
        elif arg.startswith("--sandbox="):
            sandbox_mode = arg.split("=", 1)[1]
        elif arg in ("-a", "--ask-for-approval"):
            approval_policy = next(iterator, None)
        elif arg.startswith("--ask-for-approval="):
            approval_policy = arg.split("=", 1)[1]
        elif arg in ("-m", "--model", "-i", "--image"):
            next(iterator, None)
        elif arg == "--add-dir":
            next(iterator, None)
        elif arg.startswith("--add-dir="):
            pass
        elif arg in ("--enable", "--disable"):
            options.extend([arg, next(iterator, "")])
        elif arg == "--full-auto":
            sandbox_mode = "workspace-write"
        elif arg in ("--dangerously-bypass-approvals-and-sandbox", "--yolo"):
            sandbox_mode = "danger-full-access"
        elif arg.startswith(("--config=", "--profile=", "--permission-profile=")):
            options.append(arg)
            if arg.startswith("--permission-profile="):
                permission_profile = arg.split("=", 1)[1]
    if not permission_profile:
        profile = {"read-only": ":read-only", "workspace-write": ":workspace"}.get(sandbox_mode)
        if not profile:
            # Do not guess or override an inherited permission policy. In-session
            # doctor remains mandatory for these configurations and other CLIs.
            return
        options.extend(["-P", profile])
    # The probe only reads state; writable root differences do not grant socket access.
    check = ["codex", "sandbox", *options, "--include-managed-config", "-C", cwd, "--", "env",
             "AGENT_TEAM_DIR=" + env["AGENT_TEAM_DIR"],
             "AGENT_TEAM_ROLE=" + env["AGENT_TEAM_ROLE"], sys.executable,
             str(Path(__file__).resolve()), "doctor"]
    try:
        result = subprocess.run(check, env=env, cwd=cwd, text=True,
                                capture_output=True, timeout=30)
    except subprocess.TimeoutExpired:
        fail("Codex team control preflight timed out; no model session started")
    record = {"ok": result.returncode == 0, "timestamp": time.time(),
              "stdout": result.stdout, "stderr": result.stderr}
    write(Path(env["AGENT_TEAM_DIR"]) / ("preflight-" + env["AGENT_TEAM_ROLE"] + ".json"), record)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        if approval_policy == "never":
            fail("Codex team control preflight failed; no model session started. " + detail)
        print("Team control preflight requires attention: " + detail
              + "\nUse in-session doctor and the normal approval flow if available.", file=sys.stderr)


def resume_options(options):
    """Keep launch options, but never replay an initial user prompt."""
    paired = {"-a", "--ask-for-approval", "-s", "--sandbox", "-P", "--permission-profile",
              "-p", "--profile", "-c", "--config", "--add-dir", "-m", "--model",
              "--effort", "--permission-mode", "--allowedTools", "--disallowedTools",
              "--enable", "--disable", "--local-provider"}
    switches = {"--no-daemon", "--yolo", "--dangerously-bypass-approvals-and-sandbox",
                "--dangerously-skip-permissions", "--dangerously-bypass-hook-trust",
                "--approve-for-me", "--strict-config", "--oss", "--search",
                "--no-alt-screen", "--auto"}
    result = []
    iterator = iter(options)
    for arg in iterator:
        if arg == "--":
            break
        if arg in paired:
            value = next(iterator, None)
            if value is None:
                fail("Missing value for saved option: " + arg)
            result.extend((arg, value))
        elif arg in switches or any(arg.startswith(option + "=") for option in paired):
            result.append(arg)
        elif arg.startswith("-"):
            fail("Cannot safely resume unsupported saved option: " + arg)
        # A positional value was the original prompt; it must not be replayed.
    return result


def run_pane(directory, name, resume=None):
    directory = Path(directory)
    deadline = time.monotonic() + 15
    while not (directory / "ready").exists():
        if (directory / "failed").exists() or time.monotonic() > deadline:
            fail("Team initialization failed")
        time.sleep(0.05)
    state = read(directory / "state.json")
    while name not in state["members"]:
        if time.monotonic() > deadline:
            fail("Worker registration failed")
        time.sleep(0.05)
        state = read(directory / "state.json")
    os.environ["AGENT_TEAM_DIR"] = str(directory)
    os.environ["AGENT_TEAM_ROLE"] = name
    worker = name != "lead"
    member = state["members"][name]
    brief = member.get("brief") if worker and not resume else None
    if worker and brief is not None and member.get("assignment"):
        assignment = member["assignment"]
        brief += ("\n\nAssignment ID: " + assignment["assignment_id"]
                  + "\nAttempt ID: " + assignment["attempt_id"]
                  + "\nUse these exact IDs when reporting this assignment.")
    cfg = state["config"]
    if worker:
        cfg = dict(cfg)
        cfg["worker_model"] = member.get("model", cfg.get("worker_model"))
        cfg["worker_effort"] = member.get("effort", cfg.get("worker_effort"))
    extra = () if worker else state["extra"]
    if resume:
        if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9._:/+=-]{0,255}", resume):
            fail("Invalid saved session ID")
        if os.environ.get("TMUX_PANE") != member["pane"] or not owned(state, member["pane"]):
            fail("Restored pane is no longer owned by this team")
        cfg = dict(cfg)
        key = "worker_args" if worker else "args"
        cfg[key] = resume_options(cfg.get(key, []))
        extra = resume_options(extra)
    args, env = command(state["tool"], cfg, "tmux", worker,
                        extra=extra, brief=brief,
                        budget=state["budget"], expert=state.get("expert", False))
    if resume:
        args += (["resume", resume] if state["tool"] == "codex" else
                 ["-s", resume] if state["tool"] == "opencode" else ["--resume", resume])
    try:
        if state["tool"] == "codex":
            codex_preflight(args, env, state["cwd"])
        code = subprocess.call(args, env=env, cwd=state["cwd"])
    except (OSError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        code = 127
    finally:
        with locked(directory) as current:
            current["members"][name]["status"] = "exited"
            if not worker:
                current["closed"] = True
                for member, item in current["members"].items():
                    if member != "lead" and owned(current, item["pane"]):
                        tmux("kill-pane", "-t", item["pane"], check=False)
    return code


def wake(state, target):
    item = state["members"][target]
    if not owned(state, item["pane"]):
        fail("Target pane has exited or is no longer owned by this team")
    buffer = "team-" + uuid.uuid4().hex
    tmux("load-buffer", "-b", buffer, "-", data="A team message is waiting. Run agent-team receive and handle it.")
    try:
        tmux("paste-buffer", "-p", "-d", "-b", buffer, "-t", item["pane"])
        tmux("send-keys", "-t", item["pane"], "Enter")
    finally:
        tmux("delete-buffer", "-b", buffer, check=False)


def new_assignment(retry_of=None):
    return {"assignment_id": uuid.uuid4().hex, "attempt_id": uuid.uuid4().hex,
            "retry_of": retry_of, "status": "running", "reports": {}}


def pending_messages(state, role):
    cursor = state["members"][role].get("cursor", 0)  # legacy sessions
    return [m for m in state["messages"] if m["to"] == role and m["id"] > cursor
            and not m.get("acknowledged", False)]


def pane_presence(state, pane):
    """Distinguish a missing pane from an unavailable control channel."""
    if not isinstance(pane, str) or not re.fullmatch(r"%[0-9]+", pane):
        return "absent"
    result = subprocess.run(tmux_argv("list-panes", "-t", state["window"], "-F", "#{pane_id}"),
                            text=True, capture_output=True)
    if result.returncode:
        return "unknown"
    if pane not in result.stdout.splitlines():
        return "absent"
    result = subprocess.run(tmux_argv("show-options", "-p", "-v", "-t", pane, "@agent_team"),
                            text=True, capture_output=True)
    if result.returncode:
        return "unknown"
    return "owned" if result.stdout.strip() == state["id"] else "unowned"


def control(argv):
    parser = argparse.ArgumentParser(description="Interactive pane team control; requires AGENT_TEAM_DIR")
    subs = parser.add_subparsers(dest="action", required=True)
    spawn = subs.add_parser("spawn")
    spawn.add_argument("name")
    spawn.add_argument("--file", required=True, help="UTF-8 task brief")
    spawn.add_argument("--model", help="Per-worker model; combined level must not exceed the lead")
    spawn.add_argument("--effort", help="Per-worker reasoning effort")
    assign = subs.add_parser("assign", help="Assign follow-up work to a settled worker")
    assign.add_argument("name")
    assign.add_argument("--file", required=True)
    assign.add_argument("--retry-of", help="Attempt ID being retried")
    assign.add_argument("--wake", action="store_true")
    assign.add_argument("--request-id", help="Stable key for retrying the same assignment request")
    send = subs.add_parser("send")
    send.add_argument("name")
    send.add_argument("--file", required=True)
    send.add_argument("--wake", action="store_true", help="Submit a notice to an idle pane; do not use while someone is typing")
    send.add_argument("--request-id", help="Stable key for retrying the same send")
    report = subs.add_parser("report")
    report.add_argument("--file", required=True)
    report.add_argument("--status", choices=["ready", "blocked"], default="ready")
    report.add_argument("--assignment", help="Assignment ID from the task brief")
    report.add_argument("--attempt", help="Attempt ID from the task brief")
    receive = subs.add_parser("receive")
    receive.add_argument("--all", action="store_true", help="Inspect mailbox history, including acknowledged messages")
    ack = subs.add_parser("ack", help="Acknowledge one received message")
    ack.add_argument("--id", required=True, type=int)
    wait = subs.add_parser("wait")
    wait.add_argument("--timeout", type=int, default=30)
    subs.add_parser("status")
    subs.add_parser("doctor", help="Check team control from the current execution context")
    stop = subs.add_parser("stop")
    stop.add_argument("name")
    args = parser.parse_args(argv)
    directory = state_dir()
    role = os.environ.get("AGENT_TEAM_ROLE", "lead")
    if args.action == "doctor":
        print(json.dumps(probe(read(directory / "state.json"), role)))
        return
    if args.action in ("spawn", "stop", "assign") or (args.action == "send" and args.wake):
        probe(read(directory / "state.json"), role)
    if args.action == "wait":
        deadline = time.monotonic() + min(max(args.timeout, 0), 60)
        while True:
            state = read(directory / "state.json")
            if pending_messages(state, role) or time.monotonic() >= deadline or state.get("closed"):
                args.action = "receive"
                args.all = False
                break
            time.sleep(0.2)
    with locked(directory) as state:
        if role not in state["members"]:
            fail("Unknown team member")
        if state.get("closed") and args.action not in ("status", "receive", "ack"):
            fail("Team is closed")
        if args.action == "spawn":
            if role != "lead":
                fail("Only the lead may spawn workers")
            if not re.fullmatch(r"[a-z][a-z0-9_-]{0,39}", args.name) or args.name == "lead":
                fail("Worker name must be a lowercase identifier other than lead")
            if args.name in state["members"]:
                fail("Member already exists; use send for follow-up work")
            active = [m for n, m in state["members"].items() if n != "lead" and owned(state, m["pane"])]
            if len(active) >= state["config"]["limit"]:
                fail("Worker limit reached; reuse or stop an existing worker")
            model = args.model or state["config"].get("worker_model") or state["config"].get("model")
            policy = model_policy_config()
            effort = (args.effort or state["config"].get("worker_effort")
                      or state["config"].get("effort") or policy["default_thinking_level"])
            validate_model_ceiling(state["config"].get("model"), state["config"].get("effort"),
                                   model, effort)
            brief = Path(args.file).read_text()
            pane = tmux("split-window", "-d", "-P", "-F", "#{pane_id}", "-t", state["members"]["lead"]["pane"], "-c", state["cwd"], runner(directory, args.name))
            try:
                tmux("set-option", "-p", "-t", pane, "@agent_team", state["id"])
                tmux("set-option", "-p", "-t", pane, "@agent_team_role", "worker")
                tmux("select-pane", "-t", pane, "-T", args.name)
                assignment = new_assignment() if state.get("protocol_version", 1) >= 2 else None
                state["members"][args.name] = {"pane": pane, "status": "running", "cursor": 0,
                                               "brief": brief, "model": model, "effort": effort,
                                               "assignment": assignment, "assignment_history": []}
                layout(state)
            except BaseException:
                tmux("kill-pane", "-t", pane, check=False)
                state["members"].pop(args.name, None)
                raise
            result = {"name": args.name, "pane": pane, "model": model, "effort": effort}
            if assignment:
                result.update(assignment_id=assignment["assignment_id"], attempt_id=assignment["attempt_id"])
        elif args.action == "assign":
            if role != "lead":
                fail("Only the lead may assign follow-up work")
            if state.get("protocol_version", 1) < 2:
                fail("This team uses the legacy protocol; use send for follow-up work")
            item = state["members"].get(args.name)
            if not item or args.name == "lead":
                fail("Unknown worker")
            body = Path(args.file).read_text()
            if args.request_id:
                prior = next((m for m in state["messages"] if m.get("request_id") == args.request_id
                              and m["from"] == role), None)
                if prior:
                    if (prior["type"] != "assignment" or prior["to"] != args.name
                            or prior["text"] != body or prior.get("retry_of") != args.retry_of):
                        fail("Request ID already used for a different message")
                    print(json.dumps({"queued": prior["id"], "to": args.name, "duplicate": True,
                                      "assignment_id": prior["assignment_id"], "attempt_id": prior["attempt_id"],
                                      "wake": "not_repeated", "next_action": "inspect recipient status"}))
                    return
            if not owned(state, item["pane"]):
                fail("Worker pane is unavailable; inspect status before assigning")
            previous = item.get("assignment")
            if item["status"] not in ("ready", "blocked"):
                fail("Worker has not reported ready or blocked")
            if args.retry_of and (not previous or args.retry_of != previous["attempt_id"]):
                fail("Retry must name the worker's current attempt")
            assignment = new_assignment(args.retry_of)
            if args.retry_of:
                assignment["assignment_id"] = previous["assignment_id"]
            if previous:
                item.setdefault("assignment_history", []).append(previous)
            item["assignment"] = assignment
            item["status"] = "assigned"
            message = {"id": state["next_message"], "from": role, "to": args.name,
                       "text": body, "type": "assignment", "timestamp": time.time(),
                       "assignment_id": assignment["assignment_id"], "attempt_id": assignment["attempt_id"],
                       "retry_of": args.retry_of}
            if args.request_id:
                message["request_id"] = args.request_id
            state["next_message"] += 1
            state["messages"].append(message)
            write(directory / "state.json", state)
            wake_status = "not_requested"
            if args.wake:
                try:
                    wake(state, args.name)
                    wake_status = "submitted"
                    item["status"] = "running"
                except (RuntimeError, OSError) as exc:
                    wake_status = "failed: " + str(exc)
            result = {"queued": message["id"], "to": args.name, "wake": wake_status,
                      "assignment_id": assignment["assignment_id"], "attempt_id": assignment["attempt_id"],
                      "next_action": "worker must receive and acknowledge the assignment"}
        elif args.action in ("send", "report"):
            target = args.name if args.action == "send" else "lead"
            if target not in state["members"]:
                fail("Unknown recipient")
            body = Path(args.file).read_text()
            assignment = state["members"][role].get("assignment") if args.action == "report" else None
            if assignment:
                if (args.assignment, args.attempt) != (assignment["assignment_id"], assignment["attempt_id"]):
                    fail("Report must name the current assignment and attempt")
                previous_report = assignment["reports"].get(args.status)
                if previous_report:
                    if previous_report["text"] != body:
                        fail("Conflicting report for this attempt and status")
                    if assignment["status"] == args.status:
                        state["members"][role]["status"] = args.status
                    result = {"queued": previous_report["message_id"], "to": target, "duplicate": True}
                    print(json.dumps(result))
                    return
                if assignment["status"] == "ready":
                    fail("Attempt is already complete")
            elif args.action == "report" and (args.assignment or args.attempt):
                fail("No current assignment for this worker")
            if args.action == "send" and args.request_id:
                prior = next((m for m in state["messages"] if m.get("request_id") == args.request_id
                              and m["from"] == role), None)
                if prior:
                    if prior["to"] != target or prior["text"] != body or prior["type"] != "send":
                        fail("Request ID already used for a different message")
                    print(json.dumps({"queued": prior["id"], "to": target, "duplicate": True,
                                      "wake": "not_repeated", "next_action": "inspect recipient status"}))
                    return
            message = {"id": state["next_message"], "from": role, "to": target, "text": body, "type": args.action, "timestamp": time.time()}
            if args.action == "send" and args.request_id:
                message["request_id"] = args.request_id
            if assignment:
                message.update(assignment_id=assignment["assignment_id"], attempt_id=assignment["attempt_id"], status=args.status)
            state["next_message"] += 1
            state["messages"].append(message)
            if args.action == "report":
                state["members"][role]["status"] = args.status
                if assignment:
                    assignment["status"] = args.status
                    assignment["reports"][args.status] = {"text": body, "message_id": message["id"]}
            write(directory / "state.json", state)
            wake_status = "not_requested"
            if args.action == "send" and args.wake:
                if state["members"][target]["status"] not in ("ready", "blocked", "assigned"):
                    wake_status = "not_idle"
                else:
                    try:
                        wake(state, target)
                        wake_status = "submitted"
                        state["members"][target]["status"] = "running"
                    except (RuntimeError, OSError) as exc:
                        wake_status = "failed: " + str(exc)
            result = {"queued": message["id"], "to": target, "wake": wake_status,
                      "next_action": "recipient must receive and acknowledge the message"}
        elif args.action == "receive":
            result = ([m for m in state["messages"] if m["to"] == role] if args.all
                      else pending_messages(state, role))
            if not args.all and state.get("protocol_version", 1) < 2 and result:
                state["members"][role]["cursor"] = result[-1]["id"]
        elif args.action == "ack":
            message = next((m for m in state["messages"] if m["id"] == args.id and m["to"] == role), None)
            if not message:
                fail("Message not found in this recipient's mailbox")
            message["acknowledged"] = True
            result = {"acknowledged": args.id}
        elif args.action == "status":
            result = {n: {"pane": m["pane"], "status": m["status"], "alive": owned(state, m["pane"]),
                                "assignment": m.get("assignment"),
                                "model": m.get("model", state["config"].get("model") if n == "lead" else state["config"].get("worker_model")),
                                "effort": m.get("effort", state["config"].get("effort") if n == "lead" else state["config"].get("worker_effort")),
                                **({"restore_status": m["restore_status"]} if m.get("restore_status") else {})}
                              for n, m in state["members"].items()}
        elif args.action == "stop":
            if role != "lead" or args.name == "lead":
                fail("Only the lead may stop workers")
            item = state["members"].get(args.name)
            if not item:
                fail("Unknown member")
            presence = pane_presence(state, item["pane"])
            if presence == "owned":
                try:
                    tmux("kill-pane", "-t", item["pane"])
                except RuntimeError:
                    pass
                presence = pane_presence(state, item["pane"])
            if presence == "absent":
                item["status"] = "stopped"
                layout(state)
                result = {"name": args.name, "status": "stopped", "pane": "absent",
                          "next_action": "review any outstanding result"}
            else:
                result = {"name": args.name, "status": "stop_unknown", "pane": presence,
                          "next_action": "inspect the pane and team status before retrying"}
    print(json.dumps(result, ensure_ascii=False))
    if args.action == "stop" and result["status"] == "stop_unknown":
        fail("Stop outcome unknown; inspect the receipt before retrying")


def main():
    global CODEX_RADAR_MENU_CACHE, CODEX_RADAR_RUNTIME
    CODEX_RADAR_RUNTIME = True
    argv = sys.argv[1:]
    if argv and argv[0] == "recommendations":
        return recommendation_command(argv[1:])
    if argv and argv[0] == "benchmarks":
        return coding_benchmark_command(argv[1:])
    if argv and argv[0] == "start":
        if len(argv) < 2 or argv[1] not in TOOLS:
            fail("Usage: agent-team start <codex|traex|claude|opencode> [--recommendation ID] [--scene SCENE] [--team] [--tmux]")
        if argv[1] in ("claude", "opencode"):
            return start_simple(argv[2:], tool=argv[1])
        return start_codex(argv[2:], tool=argv[1])
    if argv and argv[0] == "solo" and len(argv) > 1 and argv[1] == "codex":
        fail("Codex tier presets were removed; use agent-team start codex [--recommendation ID]")
    if argv and argv[0] == "solo":
        return launch_solo(argv[1:])
    if not argv or argv == ["--tmux"]:
        if not sys.stdin.isatty():
            fail("Choose a CLI explicitly: agent-team <codex|traex|opencode|claude> [--tmux]")
        available = [tool for tool in TOOLS if shutil.which(tool)]
        if not available:
            fail("No supported coding agent is installed")
        for number, tool in enumerate(available, 1):
            print(f"{number}. {tool}")
        choice = input("Coding agent [1]: ").strip() or "1"
        if not choice.isdigit() or not 1 <= int(choice) <= len(available):
            fail("Invalid agent selection")
        tool = available[int(choice) - 1]
        if tool == "codex":
            CODEX_RADAR_MENU_CACHE = prepare_recommendations()
            no_fast = False
            while True:
                recommendations = recommendation_items(CODEX_RADAR_MENU_CACHE)
                for number, item in enumerate(recommendations, 1):
                    print(f"{number}. {item['label']}")
                for item in CODEX_RADAR_MENU_CACHE.get("unavailable_scenes", []):
                    if isinstance(item, dict) and isinstance(item.get("label"), str):
                        print(item["label"] + " · 暂无推荐")
                print("0. Codex defaults (choose model after launch)")
                if not recommendations:
                    print("Presets unavailable; Codex defaults are available.")
                default = "1" if recommendations else "0"
                choice = input("Preset [" + default + "] (r: refresh, f: toggle Fast off): ").strip() or default
                if choice.lower() == "f":
                    no_fast = not no_fast
                    print("Fast: " + ("off" if no_fast else "follow recommendation"))
                    continue
                if choice.lower() == "r":
                    try:
                        result = sync_all_benchmarks(force=True)
                        if result["status"] in ("failed", "busy"):
                            fail("Benchmark refresh " + result["status"])
                        CODEX_RADAR_MENU_CACHE = prepare_recommendations(fetch_if_missing=False)
                        print("Some sources failed; retained cached data." if result["status"] == "partial"
                              else "Presets refreshed.")
                    except (RuntimeError, OSError) as error:
                        print("Preset refresh failed: " + str(error), file=sys.stderr)
                    continue
                if choice == "0":
                    flags = []
                elif recommendations:
                    if not choice.isdigit() or not 1 <= int(choice) <= len(recommendations):
                        fail("Invalid recommendation selection")
                    flags = ["--recommendation", recommendations[int(choice) - 1]["id"]]
                else:
                    fail("Invalid recommendation selection")
                if no_fast:
                    flags.append("--no-fast")
                break
            team = input("模式: 1. Single  2. Team [1]: ").strip() or "1"
            if team not in ("1", "2"):
                fail("Invalid mode selection")
            if team == "2":
                flags.append("--team")
            flags.extend(argv)
            return start_codex(flags, tool=tool)
        if tool == "traex":
            scenes = scene_names(tool)
            labels = "  ".join(f"{number}. {SCENE_LABELS.get(scene, scene)}" for number, scene in enumerate(scenes, 1))
            choice = input("场景: " + labels + " [1]: ").strip() or "1"
            if not choice.isdigit() or not 1 <= int(choice) <= len(scenes):
                fail("Invalid scene selection")
            team = input("模式: 1. Single  2. Team [1]: ").strip() or "1"
            if team not in ("1", "2"):
                fail("Invalid mode selection")
            flags = ["--scene", scenes[int(choice) - 1]]
            if team == "2":
                flags.append("--team")
                flags.extend(argv)
            return start_codex(flags, tool=tool)
        mode = input("模式: 1. Single  2. Team [1]: ").strip() or "1"
        if mode not in ("1", "2"):
            fail("Invalid mode selection")
        flags = ["--team", *argv] if mode == "2" else []
        return start_simple(flags, tool=tool)
    if argv[0] in ("codex", "traex"):
        return start_codex(["--team", *argv[1:]], tool=argv[0])
    if argv[0] in TOOLS:
        return launch(argv[0], argv[1:])
    if argv[0] in ("-h", "--help"):
        print("Usage: agent-team [--tmux]  # choose a coding agent interactively\n"
              "       agent-team recommendations <status|refresh|prepare|sync|schedule>\n"
              "       agent-team benchmarks <status|refresh>\n"
              "       agent-team <traex|opencode|claude> [--team-budget] [--tmux] [CLI args]\n"
              "       agent-team start <codex|traex|claude|opencode> [--recommendation ID] [--scene SCENE] [--team] [--tmux] [--fast|--no-fast] [--yolo|--no-yolo] [CLI args]\n"
              "Codex recommendations use ModelDial, Terminal-Bench and CUA-Speedrun; without a recommendation Codex uses its defaults. Trae scenes: daily|hard|batch.\n"

              "       agent-team solo traex budget [TraeX args]\n"
              "       agent-team run <traex|opencode|claude> [--budget] [--no-yolo] [CLI args]\n"
              "       agent-team <spawn|assign|send|report|receive|ack|wait|status|stop|doctor> --help\n"
              "Team default: YOLO and native subagents. --no-yolo inherits CLI permissions. --tmux: interactive pane workers only.\n"
              "--team-dry-run and --solo-dry-run print launch plans without starting an agent.\n"
              "Configure combinations in $XDG_CONFIG_HOME/agent-team/config.json.")
        return
    if len(sys.argv) > 2 and sys.argv[1] == "launch":
        if sys.argv[2] not in TOOLS:
            fail("Unsupported CLI")
        return launch(sys.argv[2], sys.argv[3:])
    if len(argv) > 1 and argv[:2] == ["run", "codex"]:
        return start_codex(argv[2:])
    if len(sys.argv) > 2 and sys.argv[1] == "run":
        if sys.argv[2] not in TOOLS:
            fail("Unsupported CLI")
        return run_direct(sys.argv[2], sys.argv[3:])
    if len(sys.argv) == 4 and sys.argv[1] == "run-pane":
        return run_pane(sys.argv[2], sys.argv[3])
    if len(sys.argv) == 5 and sys.argv[1] == "resume-pane":
        return run_pane(sys.argv[2], sys.argv[3], sys.argv[4])
    return control(sys.argv[1:])


if __name__ == "__main__":
    CODEX_RADAR_RUNTIME = True
    try:
        sys.exit(main() or 0)
    except (RuntimeError, OSError, ValueError, KeyError, subprocess.CalledProcessError) as exc:
        print("agent-team: " + str(exc), file=sys.stderr)
        sys.exit(1)
