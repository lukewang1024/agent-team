#!/usr/bin/env python3
"""Native team launch adapters and an opt-in interactive tmux team controller."""
import argparse
import contextlib
import hashlib
import http.client
from html.parser import HTMLParser
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

ROOT = Path(__file__).resolve().parents[1]
CONFIG = ROOT / "config"
TOOLS = ("codex", "traex", "opencode", "claude")
TEAM_BORDER_FORMAT = " #{?@agent_team_role,#{@agent_team_role} | ,}#{pane_title} "
CODEX_RADAR_MENU_CACHE = None
CODEX_RADAR_RUNTIME = False


def fail(message):
    raise RuntimeError(message)


def read(path):
    return json.loads(Path(path).read_text())


def write(path, value):
    path = Path(path)
    temp = path.with_name(path.name + "." + str(os.getpid()) + "." + uuid.uuid4().hex + ".tmp")
    temp.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n")
    temp.chmod(0o600)
    temp.replace(path)


def merge(base, extra):
    for key, value in extra.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            merge(base[key], value)
        else:
            base[key] = value
    return base


def codex_radar_options():
    options = read(CONFIG / "codexradar.json")
    if not isinstance(options, dict):
        fail("Codex Radar settings must be an object")
    user_config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-team/config.json"
    if user_config.exists():
        user_settings = read(user_config)
        if not isinstance(user_settings, dict):
            fail("User configuration must be an object in " + str(user_config))
        personal = user_settings.get("codex_radar", {})
        if not isinstance(personal, dict):
            fail("codex_radar settings must be an object in " + str(user_config))
        merge(options, personal)
    url = options.get("url")
    if not isinstance(url, str) or not url.startswith("https://"):
        fail("Codex Radar URL must use HTTPS")
    html_fallback_url = options.get("html_fallback_url")
    if html_fallback_url is not None and (
            not isinstance(html_fallback_url, str) or not html_fallback_url.startswith("https://")):
        fail("Codex Radar html_fallback_url must use HTTPS")
    interval = options.get("refresh_interval_seconds", 86400)
    if type(interval) not in (int, float) or interval < 60:
        fail("Codex Radar refresh_interval_seconds must be at least 60")
    failure_interval = options.get("failure_retry_interval_seconds", 300)
    if type(failure_interval) not in (int, float) or failure_interval < 60:
        fail("Codex Radar failure_retry_interval_seconds must be at least 60")
    menu_category_limit = options.get("menu_category_limit", 4)
    if type(menu_category_limit) is not int or menu_category_limit < 1:
        fail("Codex Radar menu_category_limit must be a positive integer")
    return options


def codex_radar_cache_path():
    cache_home = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache")))
    return cache_home / "agent-team" / "codexradar-recommendations.json"


def codex_radar_pending_cache_path():
    return codex_radar_cache_path().with_name("codexradar-recommendations.pending.json")


def codex_radar_url_label(url):
    parsed = urllib.parse.urlsplit(url)
    host = parsed.hostname or "unknown-host"
    if parsed.port:
        host += ":" + str(parsed.port)
    return urllib.parse.urlunsplit((parsed.scheme, host, parsed.path, "", ""))


def normalize_codex_radar(data, options):
    if not isinstance(data, dict) or data.get("ok") is False:
        fail("Codex Radar returned an invalid recommendations document")
    if "schema" in data and data["schema"] != 1:
        fail("Codex Radar returned an unsupported recommendations schema")
    recommendations = data.get("recommendations")
    if not isinstance(recommendations, list):
        fail("Codex Radar response has no recommendations list")

    normalized = {"items": []}
    for record_index, recommendation in enumerate(recommendations):
        if not isinstance(recommendation, dict):
            continue
        source_key = next((recommendation[key].strip() for key in
                           ("key", "scene", "scene_key", "category", "id", "slug")
                           if isinstance(recommendation.get(key), str) and recommendation[key].strip()), None)
        source_label = next((recommendation[key].strip() for key in
                             ("title", "name", "label", "display_name", "scene_name", "category_name")
                             if isinstance(recommendation.get(key), str) and recommendation[key].strip()), None)
        source_key = source_key or source_label or ("recommendation-" + str(record_index + 1))
        source_label = source_label or re.sub(r"[_-]+", " ", source_key).strip()
        source_label = "".join(character for character in source_label
                               if character.isprintable() and character != "#").strip()[:80]
        if not source_label:
            source_label = "CodexRadar recommendation " + str(record_index + 1)
        items = recommendation.get("items")
        if isinstance(items, list):
            candidates = items
        elif isinstance(items, dict):
            candidates = [items]
        else:
            candidate = recommendation.get("recommendation", recommendation)
            candidates = candidate if isinstance(candidate, list) else [candidate]
        source_id = re.sub(r"[^A-Za-z0-9._-]+", "-", source_key.lower()).strip("-._")[:64]
        if not source_id:
            source_id = "recommendation-" + hashlib.sha256(source_key.encode("utf-8")).hexdigest()[:12]
        for item in candidates:
            if not isinstance(item, dict):
                continue
            model = item.get("model", item.get("model_id"))
            effort = item.get("effort", item.get("reasoning_effort", item.get("reasoning_level")))
            if not isinstance(model, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._ -]{0,63}", model.strip()):
                continue
            if not isinstance(effort, str) or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_ -]{0,23}", effort.strip()):
                continue
            raw_model = model.strip()
            raw_effort = effort.strip()
            model_id = re.sub(r"\s+", "-", raw_model.lower())
            effort_id = re.sub(r"[\s_-]+", "", raw_effort.lower())
            stable_suffix = hashlib.sha256((source_key + "\0" + model_id + "\0" + effort_id).encode("utf-8")).hexdigest()[:10]
            normalized["items"].append({
                "id": source_id + "-" + stable_suffix,
                "source_key": source_key,
                "label": source_label + " · " + raw_model + " " + raw_effort,
                "model": model_id,
                "effort": effort_id,
            })
    if recommendations and not normalized["items"]:
        fail("Codex Radar response contains no usable model/effort recommendations")
    return normalized


class CodexRadarHTMLParser(HTMLParser):
    BLOCK_TAGS = {
        "article", "aside", "blockquote", "br", "dd", "div", "dl", "dt",
        "figcaption", "figure", "footer", "form", "header", "li", "main",
        "nav", "ol", "p", "section", "table", "td", "th", "tr", "ul",
    }
    INLINE_TAGS = {"b", "code", "em", "i", "span", "strong"}
    SKIP_TAGS = {"script", "style", "noscript", "template"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.events = []
        self.text = []
        self.heading = None
        self.skipping = None

    def flush_text(self):
        value = "".join(self.text)
        if value.strip():
            self.events.append(("text", value))
        self.text = []

    def handle_starttag(self, tag, attrs):
        if self.skipping:
            return
        if tag in self.SKIP_TAGS:
            self.flush_text()
            self.skipping = tag
            return
        if len(tag) == 2 and tag[0] == "h" and tag[1] in "123456":
            self.flush_text()
            self.heading = (int(tag[1]), [])
            return
        if tag in self.BLOCK_TAGS:
            target = self.heading[1] if self.heading else self.text
            target.append("\n")
        elif tag in self.INLINE_TAGS:
            target = self.heading[1] if self.heading else self.text
            target.append(" ")

    def handle_endtag(self, tag):
        if self.skipping:
            if tag == self.skipping:
                self.skipping = None
            return
        if self.heading and len(tag) == 2 and tag[0] == "h" and tag[1] in "123456":
            level, parts = self.heading
            label = re.sub(r"\s+", " ", "".join(parts)).strip()
            self.events.append(("heading", level, label))
            self.heading = None
        elif tag in self.BLOCK_TAGS:
            self.text.append("\n")
        elif tag in self.INLINE_TAGS:
            self.text.append(" ")

    def handle_data(self, data):
        if self.skipping:
            return
        target = self.heading[1] if self.heading else self.text
        target.append(data)


def normalize_codex_radar_html(document, options):
    parser = CodexRadarHTMLParser()
    parser.feed(document)
    parser.close()

    section_level = None
    scene_level = None
    scenes = []
    current_scene = None
    in_section = False
    for event in parser.events:
        if event[0] == "heading":
            _, level, label = event
            compact_label = re.sub(r"[^a-z0-9\u3400-\u9fff]+", "", label.lower())
            if not in_section and ("站长推荐" in compact_label or "stationpicks" in compact_label
                                   or "stationrecommendations" in compact_label):
                in_section = True
                section_level = level
                continue
            if not in_section:
                continue
            if level <= section_level:
                break
            if scene_level is None:
                scene_level = level
            if level == scene_level:
                current_scene = {"title": label, "text": []}
                scenes.append(current_scene)
            elif current_scene is not None:
                current_scene["text"].append(label)
        elif in_section and current_scene is not None:
            current_scene["text"].append(event[1])

    if not scenes:
        fail("Codex Radar homepage has no recognizable Station Picks section")

    model_effort_pattern = re.compile(
        r"(?P<model>[A-Za-z0-9][A-Za-z0-9._-]*(?:[ \t]+[A-Za-z0-9][A-Za-z0-9._-]*)*)"
        r"[ \t]+(?P<effort>[A-Za-z][A-Za-z0-9_-]{0,23})",
        re.IGNORECASE,
    )
    raw_recommendations = []
    for scene in scenes:
        text = re.sub(r"[\u00a0\u3000]+", " ", "\n".join(scene["text"]))
        items = []
        seen = set()
        for line in text.splitlines():
            line = re.sub(r"(?i)(?:\s*[+＋]\s*|\s+)(?:fast|ultrafast)\b", " ", line)
            line = line.strip(" \t\n.,;:|/()[]{}·")
            for segment in re.split(r"\s*(?:/|·|;|；|\||,|，)\s*", line):
                match = model_effort_pattern.fullmatch(segment.strip())
                if not match:
                    continue
                model = match.group("model").strip(" \t\n.,;:|/()[]{}")
                effort = match.group("effort").lower()
                if (not model or effort in ("fast", "ultrafast")
                        or not any(character.isalpha() for character in model)
                        or not any(character.isdigit() for character in model)):
                    continue
                identity = (re.sub(r"\s+", "-", model.lower()), effort)
                if identity in seen:
                    continue
                seen.add(identity)
                items.append({"model": model, "effort": effort})
        if not items:
            continue
        key = re.sub(r"[^a-z0-9]+", "_", scene["title"].lower()).strip("_")
        if not key:
            key = "scene-" + hashlib.sha256(scene["title"].encode("utf-8")).hexdigest()[:12]
        raw_recommendations.append({"key": key, "title": scene["title"], "items": items})

    if not raw_recommendations:
        fail("Codex Radar homepage Station Picks contained no recognizable model/effort values")
    return normalize_codex_radar({"recommendations": raw_recommendations}, options)


def read_codex_radar_cache(path=None):
    path = Path(path) if path else codex_radar_cache_path()
    try:
        cache = read(path)
    except (OSError, ValueError, TypeError):
        return None
    if not isinstance(cache, dict):
        return None
    if cache.get("version") == 1:
        # Drop the old hard-coded scene map but retain the failed-attempt
        # timestamp and diagnostic so migration does not erase useful status.
        cache = dict(cache)
        cache.pop("scenes", None)
        cache["version"] = 2
        cache["recommendations"] = {"items": []}
    if cache.get("version") != 2:
        return None
    if not isinstance(cache.get("recommendations"), dict):
        return None
    return cache


def codex_radar_fetch(opener, url, accept):
    request = urllib.request.Request(
        url,
        headers={
            "Accept": accept,
            "User-Agent": "agent-team/1 Codex-Radar-recommendations",
            "Origin": "https://codexradar.com",
            "Referer": "https://codexradar.com/",
        },
    )
    with opener.open(request, timeout=4) as response:
        body = response.read(2 * 1024 * 1024 + 1)
    if len(body) > 2 * 1024 * 1024:
        fail("Codex Radar response exceeds the 2 MiB limit")
    return body


def codex_radar_error_detail(url, error):
    if isinstance(error, urllib.error.HTTPError):
        detail = "HTTPError:" + str(error.code)
    elif isinstance(error, RuntimeError):
        detail = str(error)
    else:
        detail = type(error).__name__
    return codex_radar_url_label(url) + " (" + detail + ")"


def update_codex_radar_recommendations(force=False, strict=False, target="active"):
    if target not in ("active", "pending"):
        fail("Codex Radar cache target must be active or pending")
    options = codex_radar_options()
    now = time.time()
    cache = read_codex_radar_cache()
    if cache and cache.get("source_url") != options["url"]:
        cache = None
    interval = options.get("refresh_interval_seconds", 86400)
    last_attempt = cache.get("last_attempt_at", cache.get("fetched_at", 0)) if cache else 0
    if not isinstance(last_attempt, (int, float)):
        last_attempt = 0
    last_attempt_url = cache.get("last_attempt_url", cache.get("source_url")) if cache else None
    if not force and cache and last_attempt_url == options["url"] and now - last_attempt < interval:
        return cache, False

    request_environment = environment({})
    proxies = {
        scheme: request_environment.get(scheme + "_proxy") or request_environment.get(scheme.upper() + "_PROXY")
        for scheme in ("http", "https")
    }
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({k: v for k, v in proxies.items() if v}))
    fetch_errors = []
    payload = None
    fetched_url = options["url"]
    source_format = "json"
    source_warning = None
    try:
        body = codex_radar_fetch(opener, options["url"], "application/json")
        payload = json.loads(body.decode("utf-8"))
        recommendations = normalize_codex_radar(payload, options)
        if not recommendations["items"] and options.get("html_fallback_url"):
            fail("Codex Radar recommendations endpoint returned no recommendations")
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError, UnicodeError, ValueError, TypeError, KeyError, RuntimeError) as primary_error:
        fetch_errors.append((options["url"], primary_error))
        fallback_url = options.get("html_fallback_url")
        if isinstance(fallback_url, str) and fallback_url != options["url"]:
            try:
                body = codex_radar_fetch(opener, fallback_url, "text/html,application/xhtml+xml")
                document = body.decode("utf-8")
                recommendations = normalize_codex_radar_html(document, options)
                fetched_url = fallback_url
                payload = {}
                source_format = "html"
                source_warning = codex_radar_error_detail(options["url"], primary_error)
            except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError, UnicodeError, ValueError, TypeError, KeyError, RuntimeError) as fallback_error:
                fetch_errors.append((fallback_url, fallback_error))

    if fetch_errors and not source_warning:
        error_summary = "; ".join(codex_radar_error_detail(url, error) for url, error in fetch_errors)
        if strict:
            fail("CodexRadar refresh failed: " + error_summary)
        if cache is None:
            cache = {"version": 2, "source_url": options["url"], "fetched_at": None,
                     "recommendations": {"items": []}}
        cache["last_attempt_at"] = now
        cache["last_attempt_url"] = options["url"]
        cache["last_error"] = error_summary
        try:
            cache_path = codex_radar_pending_cache_path() if target == "pending" else codex_radar_cache_path()
            cache_path.parent.mkdir(parents=True, exist_ok=True)
            write(cache_path, cache)
        except OSError:
            if strict:
                raise
        return cache, False

    cache = {
        "version": 2,
        "source_url": options["url"],
        "last_attempt_url": options["url"],
        "fetched_at": now,
        "source_updated_at": payload.get("generated_at") or payload.get("updated_at"),
        "last_attempt_at": now,
        "fetched_from_url": fetched_url,
        "source_format": source_format,
        "source_warning": source_warning,
        "recommendations": recommendations,
    }
    try:
        cache_path = codex_radar_pending_cache_path() if target == "pending" else codex_radar_cache_path()
        cache_path.parent.mkdir(parents=True, exist_ok=True)
        write(cache_path, cache)
    except OSError:
        if strict:
            raise
    return cache, True


def codex_radar_has_data(cache):
    recommendations = cache.get("recommendations", {}) if cache else {}
    items = recommendations.get("items") if isinstance(recommendations, dict) else None
    return isinstance(items, list) and bool(items)


def codex_radar_refresh_lock_path():
    return codex_radar_cache_path().with_name("codexradar-recommendations.refresh.lock")


def start_codex_radar_background_refresh():
    cache_path = codex_radar_cache_path()
    lock_path = codex_radar_refresh_lock_path()
    try:
        cache_path.parent.mkdir(parents=True, exist_ok=True)
    except OSError:
        return False
    for _ in range(2):
        try:
            descriptor = os.open(lock_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            try:
                if time.time() - lock_path.stat().st_mtime > 600:
                    lock_path.unlink()
                    continue
            except OSError:
                pass
            return False
        except OSError:
            return False
        try:
            os.write(descriptor, str(os.getpid()).encode("ascii"))
        except OSError:
            try:
                lock_path.unlink()
            except OSError:
                pass
            return False
        finally:
            os.close(descriptor)
        try:
            subprocess.Popen(
                [sys.executable, str(Path(__file__).resolve()), "__refresh-codex-radar"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=environment({}),
                close_fds=True,
                start_new_session=True,
            )
        except OSError:
            try:
                lock_path.unlink()
            except OSError:
                pass
            return False
        return True
    return False


def run_codex_radar_background_refresh():
    try:
        update_codex_radar_recommendations(force=True, target="pending")
    finally:
        try:
            codex_radar_refresh_lock_path().unlink()
        except FileNotFoundError:
            pass


def promote_codex_radar_pending(options):
    pending_path = codex_radar_pending_cache_path()
    pending = read_codex_radar_cache(pending_path)
    if pending is None:
        return read_codex_radar_cache()
    active = read_codex_radar_cache()
    if active and active.get("source_url") != options["url"]:
        active = None
    if pending.get("source_url") == options["url"]:
        pending_time = pending.get("last_attempt_at", pending.get("fetched_at", 0))
        active_time = active.get("last_attempt_at", active.get("fetched_at", 0)) if active else 0
        if not isinstance(pending_time, (int, float)):
            pending_time = 0
        if not isinstance(active_time, (int, float)):
            active_time = 0
        if active is None or pending_time >= active_time:
            try:
                write(codex_radar_cache_path(), pending)
                active = pending
            except OSError:
                return active
    try:
        pending_path.unlink()
    except OSError:
        pass
    return active


def prepare_codex_radar_for_menu():
    options = codex_radar_options()
    cache = promote_codex_radar_pending(options)
    if cache and cache.get("source_url") != options["url"]:
        cache = None
    if cache is None:
        cache, _ = update_codex_radar_recommendations(force=True)
        return cache

    last_attempt = cache.get("last_attempt_at", cache.get("fetched_at", 0))
    if not isinstance(last_attempt, (int, float)):
        last_attempt = 0
    has_data = codex_radar_has_data(cache)
    interval = options.get("refresh_interval_seconds", 86400)
    retry_interval = interval if has_data else options.get("failure_retry_interval_seconds", 300)
    if time.time() - last_attempt >= retry_interval:
        if has_data:
            start_codex_radar_background_refresh()
        else:
            cache, _ = update_codex_radar_recommendations(force=True)
    return cache


def apply_codex_radar_recommendation(target, recommendation, key, updated_at, team_roles=True):
    target["model"] = recommendation["model"]
    target["effort"] = recommendation["effort"]
    if team_roles:
        target["worker_model"] = recommendation["model"]
        target["worker_effort"] = recommendation["effort"]
        target.pop("lead_model", None)
        target.pop("lead_effort", None)
    target["recommendation_source"] = "codexradar.com"
    target["recommendation_key"] = recommendation.get("source_key", key)
    target["recommendation_updated_at"] = updated_at


def recommendation_timestamp(cache):
    if cache.get("source_updated_at"):
        return str(cache["source_updated_at"])
    fetched_at = cache.get("fetched_at")
    if isinstance(fetched_at, (int, float)):
        return time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(fetched_at))
    return None


def codex_radar_command(argv):
    parser = argparse.ArgumentParser(prog="agent-team recommendations")
    parser.add_argument("action", choices=("status", "refresh", "prepare"))
    args = parser.parse_args(argv)
    if args.action == "refresh":
        cache, _ = update_codex_radar_recommendations(force=True, strict=True)
        try:
            codex_radar_pending_cache_path().unlink()
        except FileNotFoundError:
            pass
    elif args.action == "prepare":
        prepare_codex_radar_for_menu()
        return
    else:
        cache = read_codex_radar_cache()
    options = codex_radar_options()
    cache_matches_source = bool(cache and cache.get("source_url") == options["url"])
    failed_endpoint = None
    if cache and cache.get("last_error"):
        endpoint = cache.get("last_attempt_url") or cache.get("source_url")
        if isinstance(endpoint, str):
            failed_endpoint = codex_radar_url_label(endpoint)
    result = {
        "source": options["url"],
        "cache_source": cache.get("source_url") if cache else None,
        "cache_needs_refresh": not cache_matches_source or not codex_radar_has_data(cache),
        "cache_file": str(codex_radar_cache_path()),
        "updated_at": recommendation_timestamp(cache) if cache_matches_source else None,
        "fetched_from_url": cache.get("fetched_from_url") if cache_matches_source else None,
        "source_format": cache.get("source_format") if cache_matches_source else None,
        "source_warning": cache.get("source_warning") if cache_matches_source else None,
        "recommendations": cache.get("recommendations", {}) if cache_matches_source else {},
        "last_error": cache.get("last_error") if cache else None,
        "last_error_endpoint": failed_endpoint,
    }
    print(json.dumps(result, ensure_ascii=False, indent=2))


SCENE_LABELS = {"daily": "日常开发", "hard": "复杂攻坚", "batch": "批量执行"}


def scene_names(tool="codex"):
    if tool == "codex":
        return ()
    return tuple(read(CONFIG / "teams.json")[tool]["scenes"])


def has_tier_pair(value, model_key="model", effort_key="effort"):
    return (isinstance(value.get(model_key), str) and bool(value[model_key])
            and isinstance(value.get(effort_key), str) and bool(value[effort_key]))


def codex_radar_model_version(model):
    match = re.search(r"\d+(?:\.\d+)*", model)
    return tuple(int(part) for part in match.group(0).split(".")) if match else ()


def codex_radar_items(cache=None):
    if cache is None:
        if not CODEX_RADAR_RUNTIME:
            return []
        cache = CODEX_RADAR_MENU_CACHE if CODEX_RADAR_MENU_CACHE is not None else read_codex_radar_cache()
    if not isinstance(cache, dict):
        return []
    try:
        options = codex_radar_options()
        if cache.get("source_url") != options["url"]:
            return []
    except (OSError, ValueError, TypeError, KeyError, RuntimeError):
        return []
    recommendations = cache.get("recommendations", {})
    items = recommendations.get("items", []) if isinstance(recommendations, dict) else []
    return [item for item in items if isinstance(item, dict)
            and isinstance(item.get("id"), str)
            and isinstance(item.get("model"), str)
            and isinstance(item.get("effort"), str)] if isinstance(items, list) else []


def codex_radar_menu_items(cache=None):
    items = codex_radar_items(cache)
    try:
        limit = codex_radar_options().get("menu_category_limit", 4)
    except (OSError, ValueError, TypeError, KeyError, RuntimeError):
        return []
    categories = {}
    for item in items:
        category = item.get("source_key")
        if not isinstance(category, str) or not category:
            category = item["id"]
        categories.setdefault(category, []).append(item)

    selected = []
    for choices in list(categories.values())[:limit]:
        _, newest = max(enumerate(choices), key=lambda choice: (
            codex_radar_model_version(choice[1]["model"]), choice[0]))
        selected.append(newest)
    return selected


def codex_settings(recommendation_id=None, team=False, cache=None):
    if cache is None and CODEX_RADAR_RUNTIME:
        cache = CODEX_RADAR_MENU_CACHE if CODEX_RADAR_MENU_CACHE is not None else read_codex_radar_cache()
    value = {"fast": False}
    recommendation = next((item for item in codex_radar_items(cache)
                           if item["id"] == recommendation_id), None) if recommendation_id else None
    if recommendation:
        apply_codex_radar_recommendation(
            value, recommendation, recommendation.get("source_key", recommendation_id),
            recommendation_timestamp(cache), team_roles=team,
        )
    value.update(recommendation_id=recommendation_id if recommendation else None)
    value.setdefault("limit", 2)
    value.setdefault("yolo", team)
    return value


def scene_settings(scene=None, team=False, adjustment=None, tool="codex"):
    if tool == "codex":
        return codex_settings(recommendation_id=scene, team=team)
    config = read(CONFIG / "teams.json")[tool]
    if scene not in config["scenes"]:
        fail("Unknown " + tool + " scene: " + str(scene))
    value = dict(config["scenes"][scene])
    override = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-team/config.json"
    if override.exists():
        personal = read(override).get(tool, {})
        merge(value, personal.get("scenes", {}).get(scene, {}))
    allowed = {"model", "effort", "lead_model", "lead_effort", "worker_model", "worker_effort", "fast", "limit", "yolo", "args", "worker_args", "env"}
    if set(value) - allowed:
        fail("Unknown scene settings: " + ", ".join(sorted(set(value) - allowed)))
    for key in ("args", "worker_args"):
        if key in value and (not isinstance(value[key], list) or not all(isinstance(arg, str) for arg in value[key])):
            fail("Scene " + key + " must be an array of CLI arguments")
    if "env" in value and (not isinstance(value["env"], dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in value["env"].items())):
        fail("Scene env must map string names to string values")
    value.setdefault("fast", False)
    if not isinstance(value["fast"], bool):
        fail("Scene fast must be a boolean")
    for key in ("model", "effort", "worker_model", "worker_effort"):
        if not isinstance(value.get(key), str) or not value[key]:
            fail("Scene " + key + " must be a nonempty string")
    for key in ("lead_model", "lead_effort"):
        if key in value and (not isinstance(value[key], str) or not value[key]):
            fail("Scene " + key + " must be a nonempty string")
    if team:
        value["model"], value["effort"] = value.get("lead_model", value["model"]), value.get("lead_effort", value["effort"])
    if adjustment:
        if adjustment != "quick":
            fail("Unknown temporary adjustment: " + adjustment)
        adjustment_value = config.get("adjustments", {}).get(adjustment)
        if not isinstance(adjustment_value, dict):
            fail("Unknown " + tool + " adjustment: " + adjustment)
        value.update(adjustment_value)
    value.update(scene=scene, adjustment=adjustment)
    value.setdefault("limit", 2)
    value.setdefault("yolo", team)
    if not isinstance(value["yolo"], bool):
        fail("Scene yolo must be a boolean")
    if type(value["limit"]) is not int or not 1 <= value["limit"] <= 2:
        fail("Team limit must be 1 or 2")
    return value


def validate_scene_models(cfg, team=False, tool="codex"):
    if tool == "traex":
        result = subprocess.run(["traex", "debug", "models"], capture_output=True, text=True, env=environment(cfg), timeout=30)
        if result.returncode:
            fail("Trae model catalog is unavailable; no fallback will be selected")
        models = json.loads(result.stdout).get("models", [])
        catalog = {alias: model for model in models for alias in (model.get("slug"), model.get("config_name")) if alias}
        return validate_catalog(cfg, team, catalog)
    if not has_tier_pair(cfg):
        return
    path = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))) / "models_cache.json"
    if not path.exists():
        fail("Codex model catalog is unavailable; cannot validate the selected CodexRadar recommendation")
    catalog = {model["slug"]: model for model in read(path).get("models", [])}
    return validate_catalog(cfg, team, catalog)


def validate_catalog(cfg, team, catalog):
    roles = [(cfg["model"], cfg["effort"])] if has_tier_pair(cfg) else []
    if team and has_tier_pair(cfg, "worker_model", "worker_effort"):
        roles.append((cfg["worker_model"], cfg["worker_effort"]))
    for model, effort in roles:
        available = catalog.get(model)
        if not available:
            fail("Configured model is unavailable: " + model + "; no fallback will be selected")
        levels = {level["effort"] for level in available.get("supported_reasoning_levels", [])}
        if effort not in levels:
            fail("Configured reasoning effort is unavailable: " + model + " / " + effort)
        if cfg["fast"] and "fast" not in available.get("additional_speed_tiers", []):
            fail("Configured scene Fast mode is unavailable for " + model)


def start_codex(argv, tool="codex"):
    parser = argparse.ArgumentParser(prog="agent-team start " + tool)
    if tool == "codex":
        parser.add_argument("--recommendation", "--scene", dest="recommendation")
    else:
        parser.add_argument("--scene", choices=scene_names(tool), default="daily")
        parser.add_argument("--adjust", choices=["quick"])
    parser.add_argument("--team", action="store_true")
    parser.add_argument("--tmux", action="store_true")
    parser.add_argument("--fast", action=argparse.BooleanOptionalAction, default=None)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--check", action="store_true", help="Validate scene availability without starting a session")
    parser.add_argument("--no-yolo", action="store_true")
    # Unknown CLI arguments retain their order and are forwarded verbatim.
    options, extra = parser.parse_known_args(argv)
    if options.tmux and not options.team:
        fail("--tmux requires --team")
    if tool == "codex":
        cfg = codex_settings(options.recommendation, options.team)
    else:
        cfg = scene_settings(options.scene, options.team, options.adjust, tool=tool)
    if options.fast is not None:
        cfg["fast"] = options.fast
        cfg["fast_explicit"] = True
    if options.no_yolo:
        cfg["yolo"] = False
    if tool == "codex" and not has_tier_pair(cfg):
        message = "CodexRadar recommendation unavailable;" if options.recommendation else "No CodexRadar recommendation selected;"
        print("agent-team: " + message + " using Codex defaults", file=sys.stderr)
    if options.check:
        validate_scene_models(cfg, options.team, tool=tool)
        options.dry_run = True
    if options.team:
        flags = (["--tmux"] if options.tmux else []) + (["--team-dry-run"] if options.dry_run else [])
        return launch(tool, flags + extra, resolved=cfg)
    args = [tool]
    if cfg.get("model") and cfg.get("effort"):
        args += ["-m", cfg["model"], "-c", "model_reasoning_effort=" + json.dumps(cfg["effort"])]
    if tool == "codex":
        args[1:1] = ["--no-daemon"]
        if cfg.get("effort"):
            args += ["-c", "plan_mode_reasoning_effort=" + json.dumps(cfg["effort"])]
        if cfg.get("fast_explicit") or cfg.get("fast"):
            args += ["-c", "service_tier=" + json.dumps("fast" if cfg["fast"] else "default")]
        args += ["-c", "agents.enabled=false"]
    else:
        args += ["--disable", "multi_agent", "--disable", "multi_agent_v2"]
    if cfg["yolo"]:
        args.append("--yolo")
    args.extend(cfg.get("args", []))
    args.extend(extra)
    if options.dry_run:
        print(json.dumps({"tool":tool, "mode":"single",
                          "recommendation_id":cfg.get("recommendation_id") if tool == "codex" else None,
                          "scene":options.scene if tool == "traex" else None,
                          "config":cfg, "argv":args}, indent=2))
        return
    # The disk catalog can predate a model rollout. Let Codex refresh it during
    # startup; only the explicit --check diagnostic validates this cached list.
    if tool == "traex":
        validate_scene_models(cfg, tool=tool)
    if not shutil.which(tool):
        fail("CLI is not installed: " + tool)
    env = {key:value for key,value in environment(cfg).items() if not key.startswith("AGENT_TEAM_")}
    return os.execvpe(tool, args, env)


def start_simple(argv, tool):
    """Launch infrequently used tools without imposing a model scene."""
    parser = argparse.ArgumentParser(prog="agent-team start " + tool, allow_abbrev=False)
    parser.add_argument("--team", action="store_true")
    parser.add_argument("--tmux", action="store_true")
    parser.add_argument("--scene")
    parser.add_argument("--adjust", choices=["quick"])
    parser.add_argument("--fast", action=argparse.BooleanOptionalAction, default=None)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--no-yolo", action="store_true")
    options, extra = parser.parse_known_args(argv)
    if options.tmux and not options.team:
        fail("--tmux requires --team")
    if options.scene is not None or options.adjust is not None or options.fast is not None:
        print(tool + ": scene/adjust/Fast options are not applied; using tool defaults", file=sys.stderr)
    if options.check and not shutil.which(tool):
        fail("CLI is not installed: " + tool)
    if options.team:
        cfg = settings(tool, False)
        if options.no_yolo:
            cfg["yolo"] = False
        flags = (["--tmux"] if options.tmux else [])
        if options.dry_run or options.check:
            flags.append("--team-dry-run")
        return launch(tool, flags + extra, resolved=cfg)
    cfg = {"env": read(CONFIG / "teams.json")[tool].get("env", {})}
    args = [tool] + extra
    if options.dry_run or options.check:
        print(json.dumps({"tool": tool, "mode": "single", "config": cfg, "argv": args}, indent=2))
        return
    if not shutil.which(tool):
        fail("CLI is not installed: " + tool)
    env = {key: value for key, value in environment(cfg).items() if not key.startswith("AGENT_TEAM_")}
    return os.execvpe(tool, args, env)


def settings(tool, budget, expert=False):
    if tool == "codex":
        if budget or expert:
            fail("Codex budget/expert presets were removed; select a CodexRadar recommendation with --recommendation ID")
        return scene_settings(team=True)
    config = read(CONFIG / "teams.json")
    if expert and tool != "codex":
        fail("Expert preset is only available for Codex")
    preset = "expert" if expert else "budget" if budget else "team"
    value = config[tool][preset].copy()
    if config[tool].get("env"):
        value["env"] = dict(config[tool]["env"])
    override = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-team/config.json"
    if override.exists():
        personal = read(override).get(tool, {})
        if personal.get("env"):
            value.setdefault("env", {})
            merge(value["env"], personal["env"])
        merge(value, personal.get(preset, {}))
    value.setdefault("yolo", True)
    if not isinstance(value["yolo"], bool):
        fail("yolo must be a boolean")
    value.setdefault("limit", 2)
    if not isinstance(value["limit"], int) or not 1 <= value["limit"] <= 2:
        fail("Team limit must be 1 or 2")
    for key in ("model", "effort", "worker_model", "worker_effort"):
        if value.get(key) is not None and not isinstance(value[key], str):
            fail(f"{key} must be a string or null")
    for key in ("args", "worker_args"):
        if key in value and (not isinstance(value[key], list) or not all(isinstance(v, str) for v in value[key])):
            fail(f"{key} must be an array of CLI argument strings")
    if "env" in value and (not isinstance(value["env"], dict)
                           or not all(isinstance(k, str) and isinstance(v, str)
                                      for k, v in value["env"].items())):
        fail("env must be a mapping of string names to string values")
    return value


def environment(cfg):
    env = os.environ.copy()
    for key, value in cfg.get("env", {}).items():
        env.setdefault(key, value)
    for name in ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY"):
        value = env.get(name) or env.get(name.lower())
        if value:
            env.setdefault(name, value)
            env.setdefault(name.lower(), value)
    return env


def solo_settings(tool, preset):
    config = read(CONFIG / "teams.json")
    if tool not in ("codex", "traex") or preset not in config[tool].get("solo", {}):
        fail("Unsupported solo tool or preset")
    value = config[tool]["solo"][preset].copy()
    override = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-team/config.json"
    if override.exists():
        merge(value, read(override).get(tool, {}).get("solo", {}).get(preset, {}))
    for key in ("model", "effort"):
        if not isinstance(value.get(key), str) or not value[key]:
            fail(f"Solo {key} must be a nonempty string")
    if not isinstance(value.get("yolo", False), bool):
        fail("Solo yolo must be a boolean")
    return value


def solo_command(tool, preset, extra=()):
    cfg = solo_settings(tool, preset)
    args = [tool]
    if tool == "codex":
        args.append("--no-daemon")
    if cfg.get("yolo", False):
        args.append("--dangerously-bypass-approvals-and-sandbox")
    args += ["-m", cfg["model"], "-c", "model_reasoning_effort=" + json.dumps(cfg["effort"])]
    args.extend(extra)
    env = {key: value for key, value in os.environ.items() if not key.startswith("AGENT_TEAM_")}
    return args, env


def launch_solo(argv):
    if len(argv) < 2:
        fail("Usage: agent-team solo <codex|traex> <preset> [CLI args]")
    tool, preset = argv[:2]
    dry = False
    literal = False
    extra = []
    for arg in argv[2:]:
        if arg == "--":
            literal = True
        if arg == "--solo-dry-run" and not literal:
            dry = True
        else:
            extra.append(arg)
    args, env = solo_command(tool, preset, extra)
    if dry:
        print(json.dumps({"tool": tool, "mode": "solo", "preset": preset,
                          "config": solo_settings(tool, preset), "argv": args}, ensure_ascii=False, indent=2))
        return
    if not shutil.which(tool):
        fail(f"CLI is not installed: {tool}")
    return os.execvpe(tool, args, env)


def instructions(mode, worker=False, cfg=None, budget=False, expert=False):
    cfg = cfg or {}
    recommendation_id = cfg.get("recommendation_id")
    scene = cfg.get("scene")
    preset = ("recommendation:" + recommendation_id + ":team" if recommendation_id else
              "scene:" + scene + ":team" if scene else
              "team-expert" if expert else "team-budget" if budget else "team")
    selected = {"recommendation_id": recommendation_id, "scene": scene,
                "fast": cfg.get("fast"), "preset": preset, "mode": mode,
                **{key: cfg.get(key) for key in ("model", "effort", "worker_model", "worker_effort")}}
    common = ("Resolved configuration for THIS invocation (authoritative; do not infer it "
              "from other profiles or repository examples):\n" + json.dumps(selected) + "\n"
              "Use exactly these configured worker settings when delegating. Never substitute "
              "another model/effort or automatically switch presets. If the native spawn tool "
              "accepts model and reasoning_effort, explicitly pass worker_model and worker_effort "
              "when non-null, with fresh context (fork_turns=none). Leave null settings inherited. "
              "If unavailable, report a blocker; do not silently fall back.\n"
              + (CONFIG / "team-rules.md").read_text())
    if worker:
        return "You are a team worker. Do not spawn agents. Follow your assigned brief.\n" + (CONFIG / "team-pane.md").read_text() + common
    marker = "Team delegation mode is enabled.\n" + common
    if mode == "tmux":
        marker += "\nPane team mode is enabled. Never use native subagents.\n" + (CONFIG / "team-pane.md").read_text()
    else:
        marker += "\nNative team mode: use native delegation only, never create panes. "
        marker += "Use team-worker when this adapter provides that agent type."
    return marker


def command(tool, cfg, mode, worker=False, extra=(), brief=None, budget=False, expert=False):
    env = environment(cfg)
    if mode == "native":
        for key in tuple(env):
            if key.startswith("AGENT_TEAM_"):
                env.pop(key)
    prompt = instructions(mode, worker, cfg, budget, expert)
    if mode == "tmux" and os.environ.get("AGENT_TEAM_DIR"):
        prefix = shlex.join(["env", "AGENT_TEAM_DIR=" + os.environ["AGENT_TEAM_DIR"],
                             "AGENT_TEAM_ROLE=" + os.environ.get("AGENT_TEAM_ROLE", "lead"), "agent-team"])
        prompt += "\nYour team command prefix (also works if the tool strips inherited environment): " + prefix
    model = cfg.get("worker_model", cfg.get("model")) if worker else cfg.get("model")
    effort = cfg.get("worker_effort", cfg.get("effort")) if worker else cfg.get("effort")
    disabled = mode == "tmux" or worker
    args = [tool]
    if tool == "codex":
        args.append("--no-daemon")
    yolo = cfg.get("yolo", True)
    if yolo and tool in ("codex", "traex"):
        args.append("--dangerously-bypass-approvals-and-sandbox")
    elif yolo and tool == "claude":
        args.append("--dangerously-skip-permissions")
    if tool in ("codex", "traex"):
        args += ["-c", "developer_instructions=" + json.dumps(prompt)]
        if tool == "codex":
            args += ["-c", "agents.enabled=" + ("false" if disabled else "true")]
        else:
            args += ["--disable" if disabled else "--enable", "multi_agent"]
            args += ["--disable" if disabled else "--enable", "multi_agent_v2"]
        if not disabled:
            if tool == "codex":
                args += ["-c", "agents.max_concurrent_threads_per_session=" + str(cfg["limit"])]
                for key, dest in [("worker_model", "default_subagent_model"), ("worker_effort", "default_subagent_reasoning_effort")]:
                    if cfg.get(key):
                        args += ["-c", "agents." + dest + "=" + json.dumps(cfg[key])]
            elif cfg.get("worker_model") or cfg.get("worker_effort"):
                role = 'developer_instructions = "Do not spawn agents. Return evidence and validation results."\n'
                for key, dest in [("worker_model", "model"), ("worker_effort", "model_reasoning_effort")]:
                    if cfg.get(key):
                        role += dest + " = " + json.dumps(cfg[key]) + "\n"
                cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "agent-team"
                cache.mkdir(parents=True, exist_ok=True)
                path = cache / ("traex-" + hashlib.sha256(role.encode()).hexdigest() + ".toml")
                path.write_text(role)
                args += ["-c", "agents.team-worker.description=" + json.dumps("Independent team work using the selected worker combination")]
                args += ["-c", "agents.team-worker.config_file=" + json.dumps(str(path))]
        if tool == "codex" and (cfg.get("fast_explicit") or cfg.get("fast")):
            args += ["-c", "service_tier=" + json.dumps("fast" if cfg["fast"] else "default")]
        if effort and tool == "codex":
            args += ["-c", "plan_mode_reasoning_effort=" + json.dumps(effort)]
        if model:
            args += ["-m", model]
        if effort:
            args += ["-c", "model_reasoning_effort=" + json.dumps(effort)]
    elif tool == "claude":
        env["CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS"] = "0"
        args += ["--append-system-prompt", prompt]
        if disabled:
            args += ["--disallowedTools", "Agent,Task"]
        else:
            definition = {"description": "Bounded team work; use for independent delegated tasks", "prompt": "Do not spawn agents. Return evidence and validation results.", "model": cfg.get("worker_model") or "inherit"}
            if cfg.get("worker_effort"):
                definition["effort"] = cfg["worker_effort"]
            args += ["--agents", json.dumps({"team-worker": definition})]
        if model:
            args += ["--model", model]
        if effort:
            args += ["--effort", effort]
    else:
        content = json.loads(env.get("OPENCODE_CONFIG_CONTENT", "{}"))
        lead = {"mode": "primary", "prompt": prompt}
        if model:
            lead["model"] = model
        if effort:
            lead["reasoningEffort"] = effort
        if disabled:
            lead["permission"] = {"task": "deny"}
        agents = {"team-lead": lead}
        if not disabled:
            sub = {"mode": "subagent", "description": "Bounded independent team work", "prompt": "Do not delegate. Return evidence and validation results.", "permission": {"task": "deny"}}
            if cfg.get("worker_model"):
                sub["model"] = cfg["worker_model"]
            if cfg.get("worker_effort"):
                sub["reasoningEffort"] = cfg["worker_effort"]
            agents["team-worker"] = sub
        if yolo:
            for definition in agents.values():
                definition["permission"] = {"*": "allow", **definition.get("permission", {})}
        merge(content, {"agent": agents})
        if yolo:
            # Replace stale per-agent overrides as well as the global default.
            content["permission"] = "allow"
            for name, definition in agents.items():
                content["agent"][name]["permission"] = definition["permission"]
        if disabled:
            permission = content.get("permission")
            if isinstance(permission, str):
                content["permission"] = {"*": permission, "task": "deny"}
            else:
                content.setdefault("permission", {})["task"] = "deny"
        env["OPENCODE_CONFIG_CONTENT"] = json.dumps(content)
        args += ["--agent", "team-lead"]
    args += cfg.get("worker_args" if worker else "args", [])
    args += list(extra)
    if brief:
        if tool == "opencode":
            args += ["--prompt", brief]
        else:
            args += ["--", brief]
    return args, env


def direct_command(tool, cfg, extra=(), budget=False):
    """Build a direct CLI invocation from the team/budget preset resolver."""
    args = [tool]
    if cfg.get("yolo", True):
        if tool in ("codex", "traex"):
            args.append("--yolo")
        elif tool == "claude":
            args.append("--dangerously-skip-permissions")
        elif tool == "opencode":
            args.append("--auto")
    if tool in ("codex", "traex"):
        model = cfg.get("worker_model") if budget and cfg.get("worker_model") else cfg.get("model")
        effort = cfg.get("worker_effort") if budget and cfg.get("worker_effort") else cfg.get("effort")
        if model:
            args += ["-m", model]
        if effort:
            args += ["-c", "model_reasoning_effort=" + json.dumps(effort)]
    elif tool == "claude":
        model = cfg.get("worker_model") if budget and cfg.get("worker_model") else cfg.get("model")
        effort = cfg.get("worker_effort") if budget and cfg.get("worker_effort") else cfg.get("effort")
        if model:
            args += ["--model", model]
        if effort:
            args += ["--effort", effort]
    elif tool == "opencode":
        model = cfg.get("worker_model") if budget and cfg.get("worker_model") else cfg.get("model")
        if model:
            args += ["--model", model]
    args += list(extra)
    if tool == "codex" and "--no-daemon" not in args:
        for arg in args[1:]:
            if arg == "--":
                break
            if (arg in ("-c", "--config", "--enable", "--disable", "--search")
                    or arg.startswith(("--config=", "--enable=", "--disable="))):
                args.insert(1, "--no-daemon")
                break
    return args


def run_direct(tool, argv):
    budget = False
    no_yolo = False
    forwarded = []
    literal = False
    for arg in argv:
        if arg == "--":
            literal = True
            forwarded.append(arg)
            continue
        if literal:
            forwarded.append(arg)
            continue
        if arg == "--budget":
            budget = True
        elif arg == "--no-yolo":
            no_yolo = True
        else:
            forwarded.append(arg)
    cfg = settings(tool, budget)
    if no_yolo:
        cfg["yolo"] = False
    args = direct_command(tool, cfg, forwarded, budget=budget)
    if not shutil.which(tool):
        fail(f"CLI is not installed: {tool}")
    return os.execvpe(args[0], args, environment(cfg))


def tmux_argv(*args):
    directory = os.environ.get("AGENT_TEAM_DIR")
    if directory and (Path(directory) / "state.json").exists():
        socket = read(Path(directory) / "state.json").get("socket")
        if socket:
            return ["tmux", "-S", socket, *args]
    return ["tmux", *args]


def tmux(*args, data=None, check=True):
    result = subprocess.run(tmux_argv(*args), input=data, text=True, capture_output=True)
    if check and result.returncode:
        fail(result.stderr.strip() or "tmux command failed")
    return result.stdout.strip()


def state_dir():
    value = os.environ.get("AGENT_TEAM_DIR")
    if not value:
        fail("This command must run inside a --tmux team session")
    return Path(value)


@contextlib.contextmanager
def locked(directory):
    import fcntl
    with (directory / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = read(directory / "state.json")
        yield state
        write(directory / "state.json", state)


def owned(state, pane):
    return tmux("show-options", "-p", "-v", "-t", pane, "@agent_team", check=False) == state["id"]


def layout(state):
    tmux("select-layout", "-t", state["window"], "main-vertical")


def runner(directory, name):
    return shlex.join([sys.executable, str(Path(__file__).resolve()), "run-pane", str(directory), name])


def working_directory(tool, argv):
    """Normalize Codex/TraeX cwd flags once so lead and workers share one cwd."""
    cwd = Path.cwd()
    forwarded = []
    iterator = iter(argv)
    for arg in iterator:
        if arg == "--":
            forwarded.extend([arg, *iterator])
            break
        if tool in ("codex", "traex") and arg in ("-C", "--cd"):
            value = next(iterator, None)
            if value is None:
                fail(arg + " requires a directory")
            cwd = Path(value).expanduser().absolute()
        elif tool in ("codex", "traex") and (arg.startswith("--cd=") or arg.startswith("-C=")):
            cwd = Path(arg.split("=", 1)[1]).expanduser().absolute()
        else:
            forwarded.append(arg)
    if not cwd.is_dir():
        fail("Working directory does not exist: " + str(cwd))
    return str(cwd.resolve()), forwarded


def probe(state, role):
    """Read-only socket/ownership check in the calling agent's execution context."""
    if role not in state["members"]:
        fail("Unknown team member")
    result = subprocess.run(tmux_argv("show-options", "-p", "-v", "-t",
                             state["members"][role]["pane"], "@agent_team"),
                            text=True, capture_output=True)
    if result.returncode:
        fail("Team control unavailable in this execution context: " + result.stderr.strip()
             + ". Stop delegation. Use the coding CLI's normal approval mechanism for "
             "this command if permitted, or relaunch with an explicitly authorized "
             "permission configuration. No native fallback or sandbox bypass is performed.")
    if result.stdout.strip() != state["id"]:
        fail("Team pane is no longer owned by this session")
    return {"ok": True, "role": role, "cwd": state["cwd"], "config": state["config"]}


def launch(tool, argv, resolved=None):
    budget = False
    expert = False
    pane_mode = False
    dry = False
    no_yolo = False
    forwarded = []
    literal = False
    for arg in argv:
        if arg == "--":
            literal = True
            forwarded.append(arg)
            continue
        if literal:
            forwarded.append(arg)
            continue
        if arg == "--team-budget":
            budget = True
        elif arg == "--team-expert":
            expert = True
        elif arg == "--tmux":
            pane_mode = True
        elif arg == "--no-yolo":
            no_yolo = True
        elif arg == "--team-dry-run":
            dry = True
        else:
            forwarded.append(arg)
    if budget and expert:
        fail("Choose only one team preset")
    cfg = resolved if resolved is not None else settings(tool, budget, expert)
    if no_yolo:
        cfg["yolo"] = False
    mode = "tmux" if pane_mode else "native"
    forbidden = {"--remote"}
    forbidden.update({"-p", "--print", "--background", "--bg"} if tool == "claude" else {"exec", "run", "attach", "serve"})
    if pane_mode and any(x in forbidden for x in forwarded):
        fail("--tmux team mode requires a local interactive session")
    cwd = os.getcwd()
    if pane_mode:
        # Include configured arguments; otherwise -C in config would still diverge.
        cwd, combined = working_directory(tool, cfg.get("args", []) + forwarded)
        cfg = dict(cfg, args=[])
        forwarded = combined
        worker_cwd, worker_args = working_directory(tool, cfg.get("worker_args", []))
        if worker_args != cfg.get("worker_args", []) and worker_cwd != cwd:
            fail("worker_args must not select a different working directory")
        cfg["worker_args"] = worker_args
    args, env = command(tool, cfg, mode, extra=forwarded, budget=budget, expert=expert)
    if dry:
        print(json.dumps({"tool": tool, "mode": mode, "config": cfg, "cwd": cwd, "argv": args}, ensure_ascii=False, indent=2))
        return
    if tool == "traex" and cfg.get("scene"):
        validate_scene_models(cfg, team=True, tool=tool)
    if not shutil.which(tool):
        fail(f"CLI is not installed: {tool}")
    if not pane_mode:
        return os.execvpe(args[0], args, env)
    if not shutil.which("tmux"):
        fail("--tmux requires tmux")
    ident = uuid.uuid4().hex[:12]
    base = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "agent-team"
    directory = base / ident
    directory.mkdir(parents=True, mode=0o700)
    state = {"id": ident, "tool": tool, "config": cfg, "budget": budget, "expert": expert,
             "cwd": cwd, "extra": forwarded, "members": {}, "messages": [], "next_message": 1}
    write(directory / "state.json", state)
    shell_command = runner(directory, "lead")
    launch_environment = environment(cfg)
    tmux_environment = []
    for key in ("PATH", "CODEX_HOME", "TRAE_HOME", "XDG_CONFIG_HOME", "XDG_STATE_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "http_proxy", "https_proxy", "all_proxy", "no_proxy"):
        if key in launch_environment:
            tmux_environment += ["-e", key + "=" + launch_environment[key]]
    try:
        if os.environ.get("TMUX"):
            target = os.environ.get("TMUX_PANE")
            if not target:
                fail("TMUX_PANE is required to identify the launch window")
            session = tmux("display-message", "-p", "-t", target, "#{session_id}")
            info = tmux("new-window", "-d", "-P", "-F", "#{window_id} #{pane_id}", "-t", session, "-n", tool + "-team", "-c", state["cwd"], *tmux_environment, shell_command)
        else:
            info = tmux("new-session", "-d", "-P", "-F", "#{window_id} #{pane_id}", "-s", "team-" + ident, "-c", state["cwd"], *tmux_environment, shell_command)
        window, pane = info.split()
        with locked(directory) as state:
            state["socket"] = tmux("display-message", "-p", "-t", pane, "#{socket_path}")
            state["window"] = window
            state["members"]["lead"] = {"pane": pane, "status": "running", "cursor": 0}
            tmux("set-option", "-p", "-t", pane, "@agent_team", ident)
            tmux("set-option", "-p", "-t", pane, "@agent_team_role", "lead")
            tmux("set-option", "-w", "-t", window, "remain-on-exit", "off")
            tmux("set-option", "-w", "-t", window, "pane-border-status", "top")
            tmux("select-pane", "-t", pane, "-T", "lead")
            tmux("set-option", "-w", "-t", window, "pane-border-format", TEAM_BORDER_FORMAT)
        (directory / "ready").touch()
        if os.environ.get("TMUX"):
            tmux("select-window", "-t", window)
            print(f"Team {ident}: {window}; state: {directory}")
        else:
            subprocess.run(["tmux", "attach-session", "-t", "team-" + ident], check=True)
    except BaseException:
        (directory / "failed").touch()
        raise


def codex_preflight(args, env, cwd):
    """Exercise the controller in Codex's sandbox without an inference call."""
    options = []
    permission_profile = None
    sandbox_mode = None
    approval_policy = None
    iterator = iter(args[1:])
    for arg in iterator:
        if arg == "--":
            break
        if arg in ("-c", "--config", "-p", "--profile", "-P", "--permission-profile"):
            value = next(iterator, None)
            if value is None:
                fail(arg + " requires a value")
            options.extend([arg, value])
            if arg in ("-P", "--permission-profile"):
                permission_profile = value
        elif arg in ("-s", "--sandbox"):
            value = next(iterator, None)
            if value is None:
                fail(arg + " requires a value")
            sandbox_mode = value
        elif arg.startswith("--sandbox="):
            sandbox_mode = arg.split("=", 1)[1]
        elif arg in ("-a", "--ask-for-approval"):
            approval_policy = next(iterator, None)
        elif arg.startswith("--ask-for-approval="):
            approval_policy = arg.split("=", 1)[1]
        elif arg in ("-m", "--model", "-i", "--image"):
            next(iterator, None)
        elif arg == "--add-dir":
            next(iterator, None)
        elif arg.startswith("--add-dir="):
            pass
        elif arg in ("--enable", "--disable"):
            options.extend([arg, next(iterator, "")])
        elif arg == "--full-auto":
            sandbox_mode = "workspace-write"
        elif arg in ("--dangerously-bypass-approvals-and-sandbox", "--yolo"):
            sandbox_mode = "danger-full-access"
        elif arg.startswith(("--config=", "--profile=", "--permission-profile=")):
            options.append(arg)
            if arg.startswith("--permission-profile="):
                permission_profile = arg.split("=", 1)[1]
    if not permission_profile:
        profile = {"read-only": ":read-only", "workspace-write": ":workspace"}.get(sandbox_mode)
        if not profile:
            # Do not guess or override an inherited permission policy. In-session
            # doctor remains mandatory for these configurations and other CLIs.
            return
        options.extend(["-P", profile])
    # The probe only reads state; writable root differences do not grant socket access.
    check = ["codex", "sandbox", *options, "--include-managed-config", "-C", cwd, "--", "env",
             "AGENT_TEAM_DIR=" + env["AGENT_TEAM_DIR"],
             "AGENT_TEAM_ROLE=" + env["AGENT_TEAM_ROLE"], sys.executable,
             str(Path(__file__).resolve()), "doctor"]
    try:
        result = subprocess.run(check, env=env, cwd=cwd, text=True,
                                capture_output=True, timeout=30)
    except subprocess.TimeoutExpired:
        fail("Codex team control preflight timed out; no model session started")
    record = {"ok": result.returncode == 0, "timestamp": time.time(),
              "stdout": result.stdout, "stderr": result.stderr}
    write(Path(env["AGENT_TEAM_DIR"]) / ("preflight-" + env["AGENT_TEAM_ROLE"] + ".json"), record)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        if approval_policy == "never":
            fail("Codex team control preflight failed; no model session started. " + detail)
        print("Team control preflight requires attention: " + detail
              + "\nUse in-session doctor and the normal approval flow if available.", file=sys.stderr)


def run_pane(directory, name):
    directory = Path(directory)
    deadline = time.monotonic() + 15
    while not (directory / "ready").exists():
        if (directory / "failed").exists() or time.monotonic() > deadline:
            fail("Team initialization failed")
        time.sleep(0.05)
    state = read(directory / "state.json")
    while name not in state["members"]:
        if time.monotonic() > deadline:
            fail("Worker registration failed")
        time.sleep(0.05)
        state = read(directory / "state.json")
    os.environ["AGENT_TEAM_DIR"] = str(directory)
    os.environ["AGENT_TEAM_ROLE"] = name
    worker = name != "lead"
    brief = state["members"][name].get("brief") if worker else None
    args, env = command(state["tool"], state["config"], "tmux", worker,
                        extra=() if worker else state["extra"], brief=brief,
                        budget=state["budget"], expert=state.get("expert", False))
    try:
        if state["tool"] == "codex":
            codex_preflight(args, env, state["cwd"])
        code = subprocess.call(args, env=env, cwd=state["cwd"])
    except (OSError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        code = 127
    finally:
        with locked(directory) as current:
            current["members"][name]["status"] = "exited"
            if not worker:
                current["closed"] = True
                for member, item in current["members"].items():
                    if member != "lead" and owned(current, item["pane"]):
                        tmux("kill-pane", "-t", item["pane"], check=False)
    return code


def wake(state, target):
    item = state["members"][target]
    if not owned(state, item["pane"]):
        fail("Target pane has exited or is no longer owned by this team")
    buffer = "team-" + uuid.uuid4().hex
    tmux("load-buffer", "-b", buffer, "-", data="A team message is waiting. Run agent-team receive and handle it.")
    try:
        tmux("paste-buffer", "-p", "-d", "-b", buffer, "-t", item["pane"])
        tmux("send-keys", "-t", item["pane"], "Enter")
    finally:
        tmux("delete-buffer", "-b", buffer, check=False)


def control(argv):
    parser = argparse.ArgumentParser(description="Interactive pane team control; requires AGENT_TEAM_DIR")
    subs = parser.add_subparsers(dest="action", required=True)
    spawn = subs.add_parser("spawn")
    spawn.add_argument("name")
    spawn.add_argument("--file", required=True, help="UTF-8 task brief")
    send = subs.add_parser("send")
    send.add_argument("name")
    send.add_argument("--file", required=True)
    send.add_argument("--wake", action="store_true", help="Submit a notice to an idle pane; do not use while someone is typing")
    report = subs.add_parser("report")
    report.add_argument("--file", required=True)
    report.add_argument("--status", choices=["ready", "blocked"], default="ready")
    subs.add_parser("receive")
    wait = subs.add_parser("wait")
    wait.add_argument("--timeout", type=int, default=30)
    subs.add_parser("status")
    subs.add_parser("doctor", help="Check team control from the current execution context")
    stop = subs.add_parser("stop")
    stop.add_argument("name")
    args = parser.parse_args(argv)
    directory = state_dir()
    role = os.environ.get("AGENT_TEAM_ROLE", "lead")
    if args.action == "doctor":
        print(json.dumps(probe(read(directory / "state.json"), role)))
        return
    if args.action in ("spawn", "stop") or (args.action == "send" and args.wake):
        probe(read(directory / "state.json"), role)
    if args.action == "wait":
        deadline = time.monotonic() + min(max(args.timeout, 0), 60)
        while True:
            state = read(directory / "state.json")
            cursor = state["members"][role].get("cursor", 0)
            if any(m["to"] == role and m["id"] > cursor for m in state["messages"]) or time.monotonic() >= deadline or state.get("closed"):
                args.action = "receive"
                break
            time.sleep(0.2)
    with locked(directory) as state:
        if role not in state["members"]:
            fail("Unknown team member")
        if state.get("closed") and args.action not in ("status", "receive"):
            fail("Team is closed")
        if args.action == "spawn":
            if role != "lead":
                fail("Only the lead may spawn workers")
            if not re.fullmatch(r"[a-z][a-z0-9_-]{0,39}", args.name) or args.name == "lead":
                fail("Worker name must be a lowercase identifier other than lead")
            if args.name in state["members"]:
                fail("Member already exists; use send for follow-up work")
            active = [m for n, m in state["members"].items() if n != "lead" and owned(state, m["pane"])]
            if len(active) >= state["config"]["limit"]:
                fail("Worker limit reached; reuse or stop an existing worker")
            brief = Path(args.file).read_text()
            pane = tmux("split-window", "-d", "-P", "-F", "#{pane_id}", "-t", state["members"]["lead"]["pane"], "-c", state["cwd"], runner(directory, args.name))
            try:
                tmux("set-option", "-p", "-t", pane, "@agent_team", state["id"])
                tmux("set-option", "-p", "-t", pane, "@agent_team_role", "worker")
                tmux("select-pane", "-t", pane, "-T", args.name)
                state["members"][args.name] = {"pane": pane, "status": "running", "cursor": 0, "brief": brief}
                layout(state)
            except BaseException:
                tmux("kill-pane", "-t", pane, check=False)
                state["members"].pop(args.name, None)
                raise
            print(json.dumps({"name": args.name, "pane": pane}))
        elif args.action in ("send", "report"):
            target = args.name if args.action == "send" else "lead"
            if target not in state["members"]:
                fail("Unknown recipient")
            message = {"id": state["next_message"], "from": role, "to": target, "text": Path(args.file).read_text(), "type": args.action, "timestamp": time.time()}
            state["next_message"] += 1
            state["messages"].append(message)
            if args.action == "report":
                state["members"][role]["status"] = args.status
            write(directory / "state.json", state)
            if args.action == "send" and args.wake:
                if state["members"][target]["status"] not in ("ready", "blocked"):
                    fail("Message queued, but target is not idle; receive it during current work")
                wake(state, target)
                state["members"][target]["status"] = "running"
            print(json.dumps({"queued": message["id"], "to": target}))
        elif args.action == "receive":
            cursor = state["members"][role].get("cursor", 0)
            messages = [m for m in state["messages"] if m["to"] == role and m["id"] > cursor]
            if messages:
                state["members"][role]["cursor"] = messages[-1]["id"]
            print(json.dumps(messages, ensure_ascii=False))
        elif args.action == "status":
            print(json.dumps({n: {"pane": m["pane"], "status": m["status"], "alive": owned(state, m["pane"])} for n, m in state["members"].items()}, indent=2))
        elif args.action == "stop":
            if role != "lead" or args.name == "lead":
                fail("Only the lead may stop workers")
            item = state["members"].get(args.name)
            if not item:
                fail("Unknown member")
            if owned(state, item["pane"]):
                tmux("kill-pane", "-t", item["pane"])
            item["status"] = "stopped"
            layout(state)


def main():
    global CODEX_RADAR_MENU_CACHE, CODEX_RADAR_RUNTIME
    CODEX_RADAR_RUNTIME = True
    argv = sys.argv[1:]
    if argv == ["__refresh-codex-radar"]:
        return run_codex_radar_background_refresh()
    if argv and argv[0] == "recommendations":
        return codex_radar_command(argv[1:])
    if argv and argv[0] == "start":
        if len(argv) < 2 or argv[1] not in TOOLS:
            fail("Usage: agent-team start <codex|traex|claude|opencode> [--recommendation ID] [--scene SCENE] [--team] [--tmux]")
        if argv[1] in ("claude", "opencode"):
            return start_simple(argv[2:], tool=argv[1])
        return start_codex(argv[2:], tool=argv[1])
    if argv and argv[0] == "solo" and len(argv) > 1 and argv[1] == "codex":
        fail("Codex tier presets were removed; use agent-team start codex [--recommendation ID]")
    if argv and argv[0] == "solo":
        return launch_solo(argv[1:])
    if not argv or argv == ["--tmux"]:
        if not sys.stdin.isatty():
            fail("Choose a CLI explicitly: agent-team <codex|traex|opencode|claude> [--tmux]")
        available = [tool for tool in TOOLS if shutil.which(tool)]
        if not available:
            fail("No supported coding agent is installed")
        for number, tool in enumerate(available, 1):
            print(f"{number}. {tool}")
        choice = input("Coding agent [1]: ").strip() or "1"
        if not choice.isdigit() or not 1 <= int(choice) <= len(available):
            fail("Invalid agent selection")
        tool = available[int(choice) - 1]
        if tool == "codex":
            CODEX_RADAR_MENU_CACHE = prepare_codex_radar_for_menu()
            recommendations = codex_radar_menu_items(CODEX_RADAR_MENU_CACHE)
            if recommendations:
                for number, item in enumerate(recommendations, 1):
                    print(f"{number}. {item['label']}")
                choice = input("CodexRadar recommendation [1]: ").strip() or "1"
                if not choice.isdigit() or not 1 <= int(choice) <= len(recommendations):
                    fail("Invalid recommendation selection")
                flags = ["--recommendation", recommendations[int(choice) - 1]["id"]]
            else:
                print("CodexRadar recommendations unavailable; using Codex defaults.")
                flags = []
            team = input("模式: 1. Single  2. Team [1]: ").strip() or "1"
            if team not in ("1", "2"):
                fail("Invalid mode selection")
            if team == "2":
                flags.append("--team")
            flags.extend(argv)
            return start_codex(flags, tool=tool)
        if tool == "traex":
            scenes = scene_names(tool)
            labels = "  ".join(f"{number}. {SCENE_LABELS.get(scene, scene)}" for number, scene in enumerate(scenes, 1))
            choice = input("场景: " + labels + " [1]: ").strip() or "1"
            if not choice.isdigit() or not 1 <= int(choice) <= len(scenes):
                fail("Invalid scene selection")
            team = input("模式: 1. Single  2. Team [1]: ").strip() or "1"
            if team not in ("1", "2"):
                fail("Invalid mode selection")
            flags = ["--scene", scenes[int(choice) - 1]]
            if team == "2":
                flags.append("--team")
                flags.extend(argv)
            return start_codex(flags, tool=tool)
        mode = input("模式: 1. Single  2. Team [1]: ").strip() or "1"
        if mode not in ("1", "2"):
            fail("Invalid mode selection")
        flags = ["--team", *argv] if mode == "2" else []
        return start_simple(flags, tool=tool)
    if argv[0] in ("codex", "traex"):
        return start_codex(["--team", *argv[1:]], tool=argv[0])
    if argv[0] in TOOLS:
        return launch(argv[0], argv[1:])
    if argv[0] in ("-h", "--help"):
        print("Usage: agent-team [--tmux]  # choose a coding agent interactively\n"
              "       agent-team recommendations <status|refresh|prepare>\n"
              "       agent-team <traex|opencode|claude> [--team-budget] [--tmux] [CLI args]\n"
              "       agent-team start <codex|traex|claude|opencode> [--recommendation ID] [--scene SCENE] [--team] [--tmux] [--fast|--no-fast] [CLI args]\n"
              "Codex recommendations are loaded from CodexRadar; without a recommendation Codex uses its defaults. Trae scenes: daily|hard|batch.\n"

              "       agent-team solo traex budget [TraeX args]\n"
              "       agent-team run <traex|opencode|claude> [--budget] [--no-yolo] [CLI args]\n"
              "       agent-team <spawn|send|report|receive|wait|status|stop|doctor> --help\n"
              "Team default: YOLO and native subagents. --no-yolo inherits CLI permissions. --tmux: interactive pane workers only.\n"
              "--team-dry-run and --solo-dry-run print launch plans without starting an agent.\n"
              "Configure combinations in $XDG_CONFIG_HOME/agent-team/config.json.")
        return
    if len(sys.argv) > 2 and sys.argv[1] == "launch":
        if sys.argv[2] not in TOOLS:
            fail("Unsupported CLI")
        return launch(sys.argv[2], sys.argv[3:])
    if len(argv) > 1 and argv[:2] == ["run", "codex"]:
        return start_codex(argv[2:])
    if len(sys.argv) > 2 and sys.argv[1] == "run":
        if sys.argv[2] not in TOOLS:
            fail("Unsupported CLI")
        return run_direct(sys.argv[2], sys.argv[3:])
    if len(sys.argv) == 4 and sys.argv[1] == "run-pane":
        return run_pane(sys.argv[2], sys.argv[3])
    return control(sys.argv[1:])


if __name__ == "__main__":
    CODEX_RADAR_RUNTIME = True
    try:
        sys.exit(main() or 0)
    except (RuntimeError, OSError, ValueError, KeyError, subprocess.CalledProcessError) as exc:
        print("agent-team: " + str(exc), file=sys.stderr)
        sys.exit(1)
